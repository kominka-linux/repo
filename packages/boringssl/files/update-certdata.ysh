#!/usr/local/bin/ysh
# Update the CA certificate bundle from curl.se.

if ! builtin test -w /etc/ssl {
    builtin echo "${0##*/}: root required to update cert." >&2
    exit 1
}

builtin cd /etc/ssl
wget -q https://curl.se/ca/cacert.pem
seed mv -f cacert.pem cert.pem
builtin echo "${0##*/}: updated cert.pem"
