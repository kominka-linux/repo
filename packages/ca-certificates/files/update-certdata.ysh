#!/usr/local/bin/ysh
# Update CA certificate bundle from curl.se (Mozilla-derived).

if ! test -w /etc/ssl {
    echo "${0##*/}: root required" >&2
    exit 1
}

wget -qO /etc/ssl/certs/ca-certificates.crt \
    https://curl.se/ca/cacert.pem

echo "${0##*/}: updated /etc/ssl/certs/ca-certificates.crt"
