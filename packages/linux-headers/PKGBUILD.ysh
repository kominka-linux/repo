#!/usr/local/bin/ysh

var name    = 'linux-headers'
var ver     = '6.19.12'
var rel     = '1'
var deps    = []
var mkdeps  = ['make']

var sources = ['https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-VERSION.tar.xz']
var checksums = ['ce5c4f1205f9729286b569b037649591555f31ca1e03cc504bd3b70b8e58a8d5']

proc build(dest) {
    var CC = ENV => get("CC", "cc")
    var HOSTCC = CC
    try { command -v gcc >/dev/null 2>&1 }
    if ! failed { setvar HOSTCC = 'gcc' }

    make HOSTCC=$HOSTCC headers

    find usr/include -name '*.h' -type f | while read -r file {
        mkdir -p "${dest}/${file%/*}"
        cp -f $file "${dest}/${file}"
    }
}
