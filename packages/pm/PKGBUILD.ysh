#!/usr/local/bin/ysh

var name    = 'pm'
var ver     = '5.5.34'
var rel     = '1'
var deps    = ['ysh', 'seed']
var mkdeps  = []

var sources   = ['pm.ysh']
var checksums = ['SKIP']

proc build(dest) {
    seed mkdir -p "${dest}/usr/bin"
    seed cp -f pm.ysh "${dest}/usr/bin/pm"
    seed chmod +x "${dest}/usr/bin/pm"
}
