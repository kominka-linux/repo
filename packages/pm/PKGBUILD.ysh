#!/usr/local/bin/ysh

var name    = 'pm'
var ver     = '5.5.28'
var rel     = '2'
var deps    = ['ysh', 'curl']
var mkdeps  = []

var sources   = ['https://github.com/kominka-linux/pm/archive/refs/heads/main.zip']
var checksums = ['SKIP']

proc build(dest) {
    mkdir -p "${dest}/usr/bin"
    # Archive extracts as pm-main/pm.ysh
    cp -f pm-main/pm.ysh "${dest}/usr/bin/pm"
    chmod +x "${dest}/usr/bin/pm"
}
