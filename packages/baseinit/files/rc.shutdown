#!/usr/local/bin/ysh
# Kominka Linux shutdown script.
# Called by seed init on shutdown/restart.

source /usr/lib/init/rc.lib

log "Loading rc.conf settings..." {
    if test -f /etc/rc.conf { source /etc/rc.conf }
}

log "Running shutdown pre hooks..." {
    run_hook pre.shutdown
}

log "Waiting for services to stop..." {
    sv force-shutdown /var/service/* >/dev/null 2>&1 || true
}

log "Saving random seed..." {
    random_seed save
}

log "Sending TERM signal to all processes..." {
    killall5 -15 2>/dev/null || true
    sleep 2
}

log "Sending KILL signal to all processes..." {
    killall5 -9 2>/dev/null || true
}

log "Unmounting filesystems and disabling swap..." {
    swapoff -a
    umount -rat nosysfs,proc,devtmpfs,tmpfs
}

log "Remounting rootfs as read-only..." {
    mount -o remount,ro /
    sync
}

log "Running shutdown post hooks..." {
    run_hook post.shutdown
}

# seed init handles the actual reboot/poweroff syscall after this
# script exits — no kpow needed.
