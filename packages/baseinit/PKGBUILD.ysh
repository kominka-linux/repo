#!/usr/local/bin/ysh

var name    = 'baseinit'
var ver     = '2.0.0'
var rel     = '1'
var deps    = []
var mkdeps  = []

# Fully self-contained — no upstream C utilities needed.
# kpow replaced by busybox init's built-in reboot/poweroff handling.
# kall replaced by busybox killall5.
var sources = [
    'files/rc.lib',
    'files/rc.boot',
    'files/rc.shutdown',
    'files/inittab',
    'files/rc.conf',
]
var checksums = [
    'aa7541121a56139c8fc37bc01cdf5818229f3e2a8b9faaddf2ce06d8d1341cf1',
    'adf5c9d4513c6ce46d34d7c25296855aed4bf62eaea1fe2598bc028dd93bed5e',
    '10093e57452e4b4389d1a3ebae9673f7240b2698537dc5a609b50c70028b74c3',
    'eb2f8283e9af9528e857b339ad3d665502723457d31d89e2f9e75b4ac4ff8e63',
    'f6d445830f39ce7c498f8be90f636c48184bc94b3904dd7c1b7e0cfe041412d0',
]

proc build(dest) {
    mkdir -p \
        "${dest}/usr/lib/init" \
        "${dest}/etc"

    install -m755 rc.lib      "${dest}/usr/lib/init/rc.lib"
    install -m755 rc.boot     "${dest}/usr/lib/init/rc.boot"
    install -m755 rc.shutdown "${dest}/usr/lib/init/rc.shutdown"
    install -m644 inittab     "${dest}/etc/inittab"
    install -m644 rc.conf     "${dest}/etc/rc.conf"
}
