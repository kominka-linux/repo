#!/usr/local/bin/ysh

var name    = 'baseinit'
var ver     = '2.0.0'
var rel     = '1'
var deps    = []
var mkdeps  = []

# Fully self-contained — no upstream C utilities needed.
# kpow replaced by seed init's built-in reboot/poweroff handling.
# kall replaced by seed killall5.
var sources = [
'files/rc.lib',
'files/rc.boot',
'files/rc.shutdown',
'files/inittab',
'files/rc.conf',
]
var checksums = [
    'aa7541121a56139c8fc37bc01cdf5818229f3e2a8b9faaddf2ce06d8d1341cf1',
    '28819d2f03ddc8bba14db674827f5a1856874988849d130a45c042f51090365b',
    '515b32adec727248bec389ac2cfb878a81aaa3bcd2a3e3a0edeeaf5e52f4a8c2',
    'eb2f8283e9af9528e857b339ad3d665502723457d31d89e2f9e75b4ac4ff8e63',
    'f6d445830f39ce7c498f8be90f636c48184bc94b3904dd7c1b7e0cfe041412d0',
]

proc build(dest) {
seed mkdir -p \
"${dest}/usr/lib/init" \
"${dest}/etc"

seed install -m755 rc.lib      "${dest}/usr/lib/init/rc.lib"
seed install -m755 rc.boot     "${dest}/usr/lib/init/rc.boot"
seed install -m755 rc.shutdown "${dest}/usr/lib/init/rc.shutdown"
seed install -m644 inittab     "${dest}/etc/inittab"
seed install -m644 rc.conf     "${dest}/etc/rc.conf"
}
