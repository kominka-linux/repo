#!/usr/local/bin/ysh

var name    = 'pkgconf'
var ver     = '2.5.1'
var rel     = '3'
var deps    = ['musl']
var mkdeps  = ['zig', 'make']

var sources = ['https://distfiles.ariadne.space/pkgconf/pkgconf-VERSION.tar.xz']
var checksums = ['cd05c9589b9f86ecf044c10a2269822bc9eb001eced2582cfffd658b0a50c243']

proc build(dest) {

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-dependency-tracking \
        --disable-nls

    sed -i '/^@MAINT_MAKEFILE@$/d' Makefile

    make ACLOCAL=true AUTOCONF=true AUTOMAKE=true
    make ACLOCAL=true AUTOCONF=true AUTOMAKE=true DESTDIR=$dest install

    seed ln -s pkgconf "${dest}/usr/bin/pkg-config"

    # Remove documentation.
    seed rm -rf "${dest}/usr/share/doc"
}
