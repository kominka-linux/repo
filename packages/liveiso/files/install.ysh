#!/usr/local/bin/ysh
# Kominka Linux installer.
# Partitions a disk, formats filesystems, copies the live rootfs, and
# optionally builds a machine-specific kernel for the target hardware.
#
# Partition layout (MBR via fdisk):
#   1: EFI System (256M, FAT32, type 0xEF)  -> /boot
#   2: Linux swap  (8G, type 0x82)
#   3: Linux root  (rest, ext4, type 0x83)

var ARCH       = $(seed uname -m)
var MNT        = '/mnt/target'
var KERNEL_VER = '6.19.12'
var KERNEL_SHA = 'ce5c4f1205f9729286b569b037649591555f31ca1e03cc504bd3b70b8e58a8d5'

var MACHINE_PROFILE = ''
var MACHINE_NAME    = ''

builtin echo "Kominka Linux Installer"
builtin echo ""

# ── Network setup ─────────────────────────────────────────────────────────────

proc setup_network() {
    var wlan = ''
    for _d in @[glob('/sys/class/net/*/wireless')] {
        if builtin test -d $_d {
            setvar wlan = $(seed basename $(seed dirname $_d))
            break
        }
    }
    if (wlan === '') { return }

    builtin echo "Wireless interface $wlan detected. Connect to WiFi now? [y/N]"
    builtin echo "(needed for machine-specific kernel download)"
    var ans; builtin read --line (&ans)
    if (ans === 'y' or ans === 'Y') { wifi-setup }
}

# ── Machine selection ─────────────────────────────────────────────────────────

proc detect_machine() {
    if (ARCH !== 'x86_64') { return }
    var machines_dir = '/usr/share/kominka/machines'
    if ! builtin test -d $machines_dir { return }

    var dmi = $(seed cat /sys/class/dmi/id/product_name 2>/dev/null || builtin true)
    if (dmi === '') { return }

    var match = $(seed awk -F= -v name=$dmi '$1 == name { print $2 }' \
        "${machines_dir}/index" 2>/dev/null || builtin true)

    builtin echo ""
    builtin echo "==> Machine detection"
    var ans = ''
    if builtin test -n $match && builtin test -f "${machines_dir}/${match}.config" {
        builtin echo "    Detected: $dmi"
        builtin echo ""
        builtin printf "    Build kernel for '%s'? [Y/n/list] " $match
        builtin read --line (&ans)
        case (ans) {
            n|N          { setglobal MACHINE_PROFILE = '' }
            l|L|list     { select_machine }
            *            { setglobal MACHINE_PROFILE = match
                           setglobal MACHINE_NAME = dmi }
        }
    } else {
        builtin echo "    Machine not in profile list (DMI: ${dmi:-unknown})"
        builtin echo ""
        builtin printf "    Build a machine-specific kernel? [y/N/list] "
        builtin read --line (&ans)
        case (ans) {
            y|Y | l|L|list { select_machine }
            *               { setglobal MACHINE_PROFILE = '' }
        }
    }

    if (MACHINE_PROFILE !== '') {
        builtin echo "    Will build: $MACHINE_PROFILE"
    } else {
        builtin echo "    Using pre-built baseline kernel."
    }
    builtin echo ""
}

proc select_machine() {
    var machines_dir = '/usr/share/kominka/machines'
    builtin echo ""
    builtin echo "    Available profiles:"
    var i = 1
    var cfgs = @[glob("${machines_dir}/*.config")]
    for cfg in (cfgs) {
        var name = $(seed basename $cfg .config)
        builtin printf '      %2d) %s\n' $i $name
        setvar i = i + 1
    }
    builtin echo ""
    builtin printf "    Enter number (or blank to use baseline): "
    var num; builtin read --line (&num)
    if (num === '') { return }

    setvar i = 1
    for cfg in (cfgs) {
        if (str(i) === num) {
            setglobal MACHINE_PROFILE = $(seed basename $cfg .config)
            setglobal MACHINE_NAME = MACHINE_PROFILE
            return
        }
        setvar i = i + 1
    }
    builtin echo "    Invalid selection — using baseline."
}

# ── Kernel installation ───────────────────────────────────────────────────────

proc install_kernel() {
    seed mkdir -p "${MNT}/boot/EFI/BOOT"

    if (ARCH === 'x86_64' and MACHINE_PROFILE !== '') {
        build_kernel_x86_64
        return
    }

    # Baseline pre-built kernel.
    var efi_name
    case (ARCH) {
        x86_64  { setvar efi_name = 'BOOTX64.EFI' }
        aarch64 { setvar efi_name = 'BOOTAA64.EFI' }
        *       { setvar efi_name = 'BOOTX64.EFI' }
    }
    seed cp /usr/share/kominka/Image "${MNT}/boot/EFI/BOOT/${efi_name}"
    builtin echo "    Baseline kernel installed."
}

proc build_kernel_x86_64() {
    var machines_dir = '/usr/share/kominka/machines'
    var profile_cfg  = "${machines_dir}/${MACHINE_PROFILE}.config"
    var build_dir    = "${MNT}/tmp/kernel-build"
    var kernel_url   = "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${KERNEL_VER}.tar.xz"

    builtin echo ""
    builtin echo "==> Building machine-specific kernel ($MACHINE_PROFILE)"
    builtin echo "    Kernel: linux-$KERNEL_VER"
    builtin echo ""

    seed mkdir -p $build_dir

    builtin echo "    Downloading kernel source (~130MB)..."
    var tarball = "${build_dir}/linux-${KERNEL_VER}.tar.xz"
    if ! wget -qO $tarball $kernel_url {
        builtin echo "    Download failed — falling back to baseline kernel."
        seed cp /usr/share/kominka/Image "${MNT}/boot/EFI/BOOT/BOOTX64.EFI"
        seed rm -rf $build_dir
        return
    }

    # Verify checksum if sha256sum is available.
    # SHA256 hashes are exactly 64 hex chars; slice to avoid quoted-space issue.
    var _sum  = $(seed sha256sum $tarball 2>/dev/null || builtin true)
    var actual = _sum[0:64]
    if (actual !== '' and actual !== KERNEL_SHA) {
        builtin echo "    Checksum mismatch — falling back to baseline kernel."
        seed cp /usr/share/kominka/Image "${MNT}/boot/EFI/BOOT/BOOTX64.EFI"
        seed rm -rf $build_dir
        return
    }

    builtin echo "    Extracting..."
    seed tar xJf $tarball -C $build_dir
    var src = "${build_dir}/linux-${KERNEL_VER}"

    # Merge base config with machine profile (later entries win).
    builtin echo "    Configuring..."
    seed cp /usr/share/kominka/kernel.config "${src}/.config"
    seed grep -v '^#' $profile_cfg | seed grep -v '^$' >> "${src}/.config"
    make -C $src ARCH=x86_64 olddefconfig 2>&1 | seed grep -v '^#' || builtin true

    var nproc = $(seed nproc 2>/dev/null || builtin echo 4)
    builtin echo "    Building kernel (10-20 minutes on $nproc cores)..."
    builtin echo "    Output: ${MNT}/boot/EFI/BOOT/BOOTX64.EFI"
    builtin echo ""

    if make -C $src ARCH=x86_64 -j$nproc bzImage {
        seed cp "${src}/arch/x86/boot/bzImage" "${MNT}/boot/EFI/BOOT/BOOTX64.EFI"
        seed cp "${src}/.config" "${MNT}/usr/share/kominka/kernel.config" 2>/dev/null || builtin true
        builtin echo ""
        builtin echo "    Kernel built and installed."
    } else {
        builtin echo ""
        builtin echo "    Build failed — falling back to baseline kernel."
        seed cp /usr/share/kominka/Image "${MNT}/boot/EFI/BOOT/BOOTX64.EFI"
    }

    builtin echo "    Cleaning up build directory..."
    seed rm -rf $build_dir
}

# ── Disk listing ──────────────────────────────────────────────────────────────

proc list_disks() {
    for dev in @[glob('/sys/block/*')] {
        var name = $(seed basename $dev)
        case (name) {
            loop*|ram*|dm-* { continue }
        }
        var size = $(seed cat "${dev}/size" 2>/dev/null || builtin echo 0)
        var size_mb = int(size) // 2048
        if (size_mb <= 0) { continue }
        var model = $(seed cat "${dev}/device/model" 2>/dev/null | seed sed 's/ *$//' || builtin true)
        builtin printf '  /dev/%-10s %6d MB  %s\n' $name $size_mb $model
    }
}

# ── Main ──────────────────────────────────────────────────────────────────────

setup_network
detect_machine

builtin echo "Available disks:"
builtin echo ""
list_disks
builtin echo ""

builtin printf "Install to (e.g. /dev/sda): "
var DISK; builtin read --line (&DISK)

if (DISK === '') { builtin echo "Aborted."; exit 0 }

if ! builtin test -b $DISK { builtin echo "error: $DISK is not a block device"; exit 1 }

var size    = $(seed cat "/sys/block/$(seed basename $DISK)/size" 2>/dev/null || builtin echo 0)
var size_mb = int(size) // 2048
var root_mb = size_mb - 256 - 8192

builtin echo ""
builtin echo "WARNING: all data on $DISK will be destroyed."
builtin echo ""
builtin echo "  Partition layout (MBR):"
builtin echo "    ${DISK}1   256M   EFI System (FAT32)   /boot"
builtin echo "    ${DISK}2     8G   Linux swap"
builtin echo "    ${DISK}3  ${root_mb}M   Linux (ext4)          /"
builtin echo ""
builtin printf "Continue? [y/N] "
var ans; builtin read --line (&ans)
if (ans !== 'y' and ans !== 'Y') { builtin echo "Aborted."; exit 0 }

builtin echo ""
builtin echo "==> Partitioning $DISK (MBR)"
seed dd if=/dev/zero of=$DISK bs=1M count=1 2>/dev/null

seed fdisk $DISK <<'FDISK'
o
n
p
1

+256M
t
ef
n
p
2

+8G
t
2
82
n
p
3



w
FDISK

seed sleep 1

var P
case (DISK) {
    *nvme*|*mmcblk* { setvar P = "${DISK}p" }
    *               { setvar P = DISK }
}

builtin echo "==> Formatting partitions"
mkfs.vfat -F32 -n KOMINKA_EFI "${P}1"
seed mkswap -L KOMINKA_SWAP "${P}2"
mkfs.ext4 -q -L KOMINKA_ROOT "${P}3"

builtin echo "==> Mounting target"
seed mkdir -p $MNT
seed mount "${P}3" $MNT
seed mkdir -p "${MNT}/boot"
seed mount "${P}1" "${MNT}/boot"

builtin echo "==> Copying rootfs"
for dir in usr etc var root {
    if builtin test -d "/$dir" { seed cp -a "/$dir" "${MNT}/" }
}
seed mkdir -p "${MNT}/dev" "${MNT}/proc" "${MNT}/sys" "${MNT}/tmp" "${MNT}/mnt"
seed ln -sf usr/bin "${MNT}/bin"
seed ln -sf usr/bin "${MNT}/sbin"
seed ln -sf usr/lib "${MNT}/lib"

seed rm -f "${MNT}/usr/bin/pm-install"

builtin echo "==> Installing kernel"
install_kernel

builtin echo "==> Writing fstab"
seed cat > "${MNT}/etc/fstab" <<'EOF'
LABEL=KOMINKA_ROOT  /      ext4  defaults  0 0
LABEL=KOMINKA_EFI   /boot  vfat  defaults  0 0
LABEL=KOMINKA_SWAP  none   swap  defaults  0 0
EOF

builtin echo ""
builtin echo "==> Setting up user account"
builtin echo ""
builtin printf "Username: "
var NEW_USER; builtin read --line (&NEW_USER)

if (NEW_USER !== '') {
    seed grep -q '^wheel:' "${MNT}/etc/group" || builtin echo "wheel:x:10:" >> "${MNT}/etc/group"

    builtin echo "${NEW_USER}:x:1000:1000:${NEW_USER}:/home/${NEW_USER}:/bin/sh" \
        >> "${MNT}/etc/passwd"
    builtin echo "${NEW_USER}:!:14871::::::" >> "${MNT}/etc/shadow"

    if seed grep -q '^wheel:.*:$' "${MNT}/etc/group" {
        seed sed -i "s/^wheel:\\(.*\\):\$/wheel:\\1:${NEW_USER}/" "${MNT}/etc/group"
    } else {
        seed sed -i "s/^wheel:\\(.*\\)/wheel:\\1,${NEW_USER}/" "${MNT}/etc/group"
    }
    builtin echo "${NEW_USER}:x:1000:" >> "${MNT}/etc/group"

    seed mkdir -p "${MNT}/home/${NEW_USER}"
    seed chown 1000:1000 "${MNT}/home/${NEW_USER}"

    builtin echo ""
    builtin echo "Set password for ${NEW_USER}:"
    seed chroot $MNT passwd $NEW_USER
    builtin echo ""
    builtin echo "  User '${NEW_USER}' created (wheel group, sudo access)."
} else {
    builtin echo "  Skipped — root-only system."
}

builtin echo ""
builtin echo "==> WiFi setup"
var WLAN = ''
for _d in @[glob('/sys/class/net/*/wireless')] {
    if builtin test -d $_d {
        setvar WLAN = $(seed basename $(seed dirname $_d))
        break
    }
}

if (WLAN !== '') {
    if builtin test -f /etc/wifi.conf {
        builtin printf "Reuse WiFi config from this session on installed system? [Y/n] "
        var _ans; builtin read --line (&_ans)
        if (_ans === 'n' or _ans === 'N') {
            wifi-setup --target $MNT
        } else {
            seed cp /etc/wifi.conf "${MNT}/etc/wifi.conf"
            seed cp /etc/wpa_supplicant.conf "${MNT}/etc/wpa_supplicant.conf" 2>/dev/null || builtin true
            seed chmod 600 "${MNT}/etc/wifi.conf" "${MNT}/etc/wpa_supplicant.conf" 2>/dev/null || builtin true
        }
    } else {
        builtin printf "Wireless interface %s detected. Configure WiFi? [y/N] " $WLAN
        var _ans; builtin read --line (&_ans)
        if (_ans === 'y' or _ans === 'Y') { wifi-setup --target $MNT }
    }

    if builtin test -f "${MNT}/etc/wifi.conf" {
        seed mkdir -p "${MNT}/var/service"
        seed ln -sf /etc/sv/wifi "${MNT}/var/service/wifi"
    }
}

builtin echo ""
builtin echo "==> Unmounting"
seed umount "${MNT}/boot"
seed umount $MNT

builtin echo ""
builtin echo "Done! Kominka Linux installed to $DISK."
if (MACHINE_NAME !== '') {
    builtin echo "Kernel: $MACHINE_PROFILE (built for $MACHINE_NAME)"
}
builtin echo "Remove installer media and reboot."
