#!/usr/local/bin/ysh

var name    = 'liveiso'
var ver     = '1'
var rel     = '2'
var deps    = ['core', 'e2fsprogs', 'dosfstools', 'wifi', 'iwlwifi-firmware']
var mkdeps  = []

var sources = [
    'files/install.ysh',
]
var checksums = [
    '097676a876f711ebca95c2f772149215e3ed65e3315d48b36a56e97b86b9f76e',
]

proc build(dest) {
    seed mkdir -p "${dest}/usr/bin"
    seed install -m755 install.ysh "${dest}/usr/bin/pm-install"
}
