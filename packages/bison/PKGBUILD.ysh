#!/usr/local/bin/ysh

var name    = 'bison'
var ver     = '3.8.2'
var rel     = '2'
var deps    = ['musl']
var mkdeps  = ['zig', 'make', 'm4']

var sources = ['https://ftp.gnu.org/gnu/bison/bison-VERSION.tar.xz']
var checksums = ['9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2']

proc build(dest) {

    # The m4 in the build environment (from the remote repo) may have been
    # built with the old zig cc setup (no -target) and produce SIGILL.
    # Rebuild m4 from source so the local cache gets a working binary, then
    # reinstall it.
    if ! m4 --version >/dev/null 2>&1 {
        pm b m4
        pm i m4
    }

    ./configure \
        --prefix=/usr \
        --disable-nls \
        --disable-dependency-tracking \
        --without-libtextstyle-prefix

    sed -i '/^@MAINT_MAKEFILE@$/d' Makefile
    sed -i '/^@[a-zA-Z_][a-zA-Z0-9_]*@$/d' Makefile
    touch Makefile

    make ACLOCAL=true AUTOCONF=true AUTOMAKE=true MAKEINFO=true PERL=true

    make DESTDIR=$dest \
        ACLOCAL=true AUTOCONF=true AUTOMAKE=true MAKEINFO=true PERL=true \
        install-libLIBRARIES \
        install-binPROGRAMS \
        install-nodist_binSCRIPTS \
        install-dist_m4sugarDATA \
        install-dist_skeletonsDATA \
        install-dist_pkgdataDATA \
        install-aclocalDATA \
        install-man1
}
