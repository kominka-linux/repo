#!/usr/local/bin/ysh

var name    = 'binutils-strip'
var ver     = '2.44'
var rel     = '2'
var deps    = ['musl']
var mkdeps  = ['zig', 'make']

var sources   = ['https://ftp.gnu.org/gnu/binutils/binutils-VERSION.tar.xz']
var checksums = ['ce2017e059d63e67ddb9240e9d4ec49c2893605035cd60e92ad53177f4377237']

proc build(dest) {
    ./configure \
        --prefix=/usr \
        --disable-nls \
        --disable-shared \
        --disable-werror \
        --enable-deterministic-archives \
        --enable-64-bit-bfd \
        --disable-ld \
        --disable-gold \
        --disable-gprof

    # Full make (skipping ld/gold/gprof); libiberty/bfd are built as deps.
    make -j$(nproc)

    install -Dm755 binutils/strip-new "${dest}/usr/bin/strip"
}
