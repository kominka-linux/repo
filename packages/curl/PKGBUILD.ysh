#!/usr/local/bin/ysh

var name    = 'curl'
var ver     = '8.19.0'
var rel     = '8'
var deps    = ['boringssl', 'zlib']
var mkdeps  = ['zig', 'make']

var sources = ['https://curl.se/download/curl-VERSION.tar.xz']
var checksums = ['4eb41489790d19e190d7ac7e18e82857cdd68af8f4e66b292ced562d333f11df']

proc build(dest) {
    var _kr = ENV => get("KOMINKA_ROOT", "")
    if (_kr === '/') { setvar _kr = '' }
    var ssl_prefix = "${_kr}/usr"

    # BoringSSL ships openssl/time.h (a compat shim). curl's configure adds
    # -isystem .../openssl which makes that file shadow the real <time.h>.
    if test -f "${_kr}/usr/include/openssl/time.h" {
        mv "${_kr}/usr/include/openssl/time.h" "${_kr}/usr/include/openssl/time.h.aside"
    }

    var _cflags = ENV => get("CFLAGS", "-O2 -DNDEBUG") ++ " -Wno-error -I${_kr}/usr/include"
    var _ldflags = ENV => get("LDFLAGS", "") ++ " -L${_kr}/usr/lib"

    var zig_bin = $(command -v zig)
    # Use zig nm — our custom nm.c doesn't produce GNU nm output which
    # libtool needs to build the global symbol pipe for libcurl.so.
    NM="$zig_bin nm" \
    CFLAGS=$_cflags LDFLAGS=$_ldflags \
        PKG_CONFIG_PATH="${_kr}/usr/lib/pkgconfig" \
        LD_LIBRARY_PATH="${_kr}/usr/lib" \
        ./configure \
        --prefix=/usr \
        --enable-ipv6 \
        --disable-manual \
        --disable-ldap \
        --disable-ares \
        --disable-ftp \
        --disable-file \
        --disable-dict \
        --disable-telnet \
        --disable-tftp \
        --disable-pop3 \
        --disable-imap \
        --disable-smb \
        --disable-smtp \
        --disable-gopher \
        --disable-mqtt \
        --disable-rtsp \
        --disable-unix-sockets \
        --disable-docs \
        --with-openssl=$ssl_prefix \
        --with-ca-fallback \
        --without-librtmp \
        --without-icu \
        --without-libpsl \
        --without-libidn \
        --without-libidn2 \
        --without-brotli \
        --without-zstd

    make
    make DESTDIR=$dest install
}
