#!/usr/local/bin/ysh

var name    = 'perl'
var ver     = '5.42.2'
var rel     = '5'
var deps    = ['musl', 'bzip2', 'zlib']
var mkdeps  = ['make']

var sources = ['https://www.cpan.org/src/5.0/perl-VERSION.tar.xz']
var checksums = ['0a585eeb9e363c0f80482ddb3571625250c2c86aeb408853e8ea50805cfb14bb']

proc build(dest) {
    var _kr = ENV => get("KOMINKA_ROOT", "")
    if (_kr === '/') { setvar _kr = '' }

    # Use system cc (Alpine gcc in bootstrap, zig cc wrapper otherwise).
    # zig's /usr/bin/ar wrapper breaks perl's Configure ("didn't work right").
    # By removing zig from mkdeps, Alpine's native binutils ar stays at
    # /usr/bin/ar and Configure tests pass correctly.
    var CC = $(command -v gcc 2>/dev/null || command -v cc)

    # zig cc doesn't add /usr/include to the system include path, so set
    # it explicitly for zlib.h and bzlib.h detection.
    var extra_inc = "-I${_kr}/usr/include"
    var extra_lib = "-L${_kr}/usr/lib"

    env BUILD_ZLIB=0 BUILD_BZIP2=0 \
    ./Configure \
        -des \
        -Dprefix=/usr \
        -Dvendorprefix=/usr \
        -Dusevendorprefix \
        -Duseshrplib \
        -Dusethreads \
        -Dinc_version_list=none \
        -Darchname="$(uname -m)-linux" \
        -Dcc="${CC}" \
        -Dccflags="-DNO_POSIX_2008_LOCALE -D_GNU_SOURCE ${extra_inc}" \
        -Dldflags="${extra_lib} -lpthread" \
        -Dlibs="-lm -lz -lbz2 -lpthread" \
        -Dman1dir=/usr/share/man/man1 \
        -Dman3dir=/usr/share/man/man3 \
        -Dman1ext=1 \
        -Dman3ext=3pm

    make
    make DESTDIR=$dest install

    # Remove unneeded files.
    find "${dest}" -name '*.pod'       -exec rm -f {} +
    find "${dest}" -name .packlist     -exec rm -f {} +
    find "${dest}" -name 'README*'     -exec rm -f {} +
    find "${dest}" -name 'TODO*'       -exec rm -f {} +
    find "${dest}" -name 'Change*'     -exec rm -f {} +
    find "${dest}" -name '*.bs'        -exec rm -f {} +
    find "${dest}" -name '*.0' -type f -exec rm -f {} +

    find "${dest}/usr/lib" -type f -exec chmod 644 {} \;
}
