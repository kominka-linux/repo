#!/usr/local/bin/ysh

var name    = 'binutils'
var ver     = '2.44'
var rel     = '1'
var deps    = ['musl']
var mkdeps  = ['zig', 'make']

var sources   = ['https://ftp.gnu.org/gnu/binutils/binutils-VERSION.tar.xz']
var checksums = [
    'ce2017e059d63e67ddb9240e9d4ec49c2893605035cd60e92ad53177f4377237',
]

proc build(dest) {
./configure \
--prefix=/usr \
--disable-nls \
--disable-shared \
--disable-werror \
--enable-deterministic-archives \
--enable-64-bit-bfd \
--disable-ld \
--disable-gold \
--disable-gprof

# Top-level configure recurses into all sub-packages, creating their Makefiles.
# config.status's awk getline can't expand AC_SUBST_FILE variables, leaving bare
# @VAR@ placeholders. Fix them all before any make invocation.
#
# Top-level: serdep.tmp holds serialization deps generated by configure;
# insert its contents then remove the placeholder line.
seed sed -i "/@serialization_dependencies@/r serdep.tmp" Makefile
# target_makefile_frag for *-linux* targets = config/mt-gnu.
sed -i 's|^@target_makefile_frag@$|CXXFLAGS_FOR_TARGET += -D_GNU_SOURCE|' Makefile
# Delete all remaining bare @VAR@ placeholders from top-level Makefile
# (serialization_dependencies placeholder after r-insert, plus alphaieee/ospace/host frags).
sed -i '/^@[a-zA-Z_][a-zA-Z0-9_]*@$/d' Makefile
touch Makefile
# Sub-package Makefiles are created lazily by make configure-XXX (not by top-level
# configure). Pre-configure all sub-packages we need so we can patch their Makefiles
# before any build step tries to parse them.
make configure-libiberty configure-bfd configure-binutils \
  ACLOCAL=true AUTOCONF=true AUTOMAKE=true
# Patch all newly-created sub-package Makefiles.
for mf in libiberty/Makefile libiberty/testsuite/Makefile \
           bfd/Makefile bfd/po/Makefile \
           binutils/Makefile binutils/po/Makefile {
    if test -f $mf {
        sed -i '/^@[a-zA-Z_][a-zA-Z0-9_]*@$/d' $mf
        touch $mf
    }
}

# Build only the sub-libraries and the two tools we need.
make all-libiberty ACLOCAL=true AUTOCONF=true AUTOMAKE=true MAKEINFO=true
make all-bfd ACLOCAL=true AUTOCONF=true AUTOMAKE=true MAKEINFO=true
make -C binutils strip-new nm-new \
  ACLOCAL=true AUTOCONF=true AUTOMAKE=true MAKEINFO=true PERL=true

seed install -Dm755 binutils/strip-new "${dest}/usr/bin/strip"
seed install -Dm755 binutils/nm-new    "${dest}/usr/bin/nm"
}
