#!/usr/local/bin/ysh

var name    = 'git'
var ver     = '2.53.0'
var rel     = '23'
var deps    = ['musl', 'zlib', 'dropbear']
var mkdeps  = ['zig', 'make', 'musl']

var sources = [
    'https://mirrors.edge.kernel.org/pub/software/scm/git/git-VERSION.tar.xz',
    'https://mirrors.edge.kernel.org/pub/software/scm/git/git-manpages-VERSION.tar.xz man',
]
var checksums = [
    '5818bd7d80b061bbbdfec8a433d609dc8818a05991f731ffc4a561e2ca18c653',
    '957ffe4409eeb90c7332bff4abee8d5169d28ef5c7c3bf08419f4239be13f77f',
]

proc build(dest) {
    var _kr = ENV => get("KOMINKA_ROOT", "")
    if (_kr === '/') { setvar _kr = '' }

    var _libs = "-L${_kr}/usr/lib -lz"

    # Include ordering for musl/zig cc (zig rel=11+ appends -I/usr/include):
    # - -Icompat/regex first: finds compat/regex/regex.h (defines REG_STARTEND)
    #   before musl's /usr/include/regex.h (which lacks REG_STARTEND)
    # - -I. before wrapper's appended -I/usr/include: git's own tar.h takes
    #   precedence over /usr/include/tar.h (musl's lacks TYPEFLAG_GLOBAL_HEADER)
    # NO_CURL: HTTP/HTTPS transport disabled; SSH-only. SSH uses the system ssh
    #   binary and needs no TLS library.
    # NO_OPENSSL: no TLS needed when curl transport is also disabled.
    # NO_* flags passed to both make invocations: the second (install) would
    # otherwise re-evaluate PROGRAM_OBJS without them and try to build
    # git-http-push (needs expat) and git-credential-gnome-keyring, etc.
    var make_flags = [
        "CC=$[ENV => get('CC', 'cc')]",
        'NO_REGEX=NeedsStartEnd',
        'NO_CURL=YesPlease',
        'NO_OPENSSL=YesPlease',
        'NO_GETTEXT=YesPlease',
        'NO_SVN_TESTS=YesPlease',
        'NO_TCLTK=YesPlease',
        'NO_EXPAT=YesPlease',
        'NO_NSEC=YesPlease',
        'NO_PYTHON=YesPlease',
        'NO_PERL=YesPlease',
        'NO_SYS_POLL_H=1',
        'NO_CROSS_DIRECTORY_HARDLINKS=1',
        'NO_INSTALL_HARDLINKS=1',
        'prefix=/usr',
        'libexecdir=/usr/lib',
        "CFLAGS=-Wall -O2 -Wno-shift-op-parentheses -Wno-bitwise-op-parentheses -DNO_REGEX -DNO_OPENSSL -DNO_EXPAT -Icompat/regex -I.",
        "LDFLAGS=${_libs}",
        'FUZZ_PROGRAMS=',
    ]

    # The test/fuzz infrastructure is pulled in by two unconditional all:: rules
    # that are never needed for an install build. Drop them from the Makefile so
    # only the real git programs are compiled. (Command-line variable overrides
    # can't suppress these because the lists are built with += in the Makefile,
    # and GNU make appends to the command-line value on each +=.)
    seed sed -i '/^all:: \$(FUZZ_OBJS)$/d; /^all:: \$(TEST_PROGRAMS)/d' Makefile

    make "-j$(seed nproc)" @make_flags all

    make "-j$(seed nproc)" @make_flags DESTDIR=$dest install

    if builtin test -d man {
        seed mkdir -p "${dest}/usr/share/man"
        seed cp -Rf man "${dest}/usr/share/"
    }

    # dropbear provides dbclient, not ssh. Point git at it system-wide.
    seed mkdir -p "${dest}/etc"
    builtin echo '[core]' >> "${dest}/etc/gitconfig"
    builtin echo '	sshCommand = dbclient' >> "${dest}/etc/gitconfig"
}
