#!/usr/local/bin/ysh

var name    = 'git'
var ver     = '2.53.0'
var rel     = '14'
var deps    = ['musl', 'curl', 'boringssl', 'zlib']
var mkdeps  = ['zig', 'make']

var sources = [
    'https://mirrors.edge.kernel.org/pub/software/scm/git/git-VERSION.tar.xz',
    'https://mirrors.edge.kernel.org/pub/software/scm/git/git-manpages-VERSION.tar.xz man',
]
var checksums = [
    '5818bd7d80b061bbbdfec8a433d609dc8818a05991f731ffc4a561e2ca18c653',
    '957ffe4409eeb90c7332bff4abee8d5169d28ef5c7c3bf08419f4239be13f77f',
]

proc build(dest) {
    var _kr = ENV => get("KOMINKA_ROOT", "")
    if (_kr === '/') { setvar _kr = '' }

    var CC = $(command -v cc)

    # Include order matters for two reasons:
    # 1. NO_REGEX=NeedsStartEnd causes git's Makefile to add -Icompat/regex to
    #    COMPAT_CFLAGS → BASIC_CFLAGS. musl lacks REG_STARTEND; with
    #    -Icompat/regex as a user include (-I), #include <regex.h> finds
    #    git's bundled compat/regex/regex.h (which defines REG_STARTEND)
    #    before musl's regex.h.
    # 2. /usr/include must be a SYSTEM include (-isystem) so that git's own
    #    headers (.-relative like tar.h) take precedence via -I. in
    #    BASIC_CFLAGS (user includes are always searched before system).
    #    Without this, /usr/include/tar.h shadows git's own tar.h.
    var _sysinc = "-isystem ${_kr}/usr/include"
    var _libs = "-L${_kr}/usr/lib -lssl -lcrypto"

    make \
        CC="$CC" \
        NO_REGEX=NeedsStartEnd \
        NO_GETTEXT=YesPlease \
        NO_SVN_TESTS=YesPlease \
        NO_TCLTK=YesPlease \
        NO_EXPAT=YesPlease \
        NO_NSEC=YesPlease \
        NO_PYTHON=YesPlease \
        NO_PERL=YesPlease \
        NO_SYS_POLL_H=1 \
        NO_CROSS_DIRECTORY_HARDLINKS=1 \
        NO_INSTALL_HARDLINKS=1 \
        prefix=/usr \
        libexecdir=/usr/lib \
        CPPFLAGS="$_sysinc" \
        CFLAGS="-Wall -O2 -DNO_REGEX -Icompat/regex" \
        LDFLAGS="$_libs" \
        FUZZ_PROGRAMS= \
        all

    make \
        NO_REGEX=NeedsStartEnd \
        prefix=/usr \
        libexecdir=/usr/lib \
        DESTDIR=$dest \
        install

    if test -d man {
        mkdir -p "${dest}/usr/share/man"
        cp -Rf man "${dest}/usr/share/"
    }
}
