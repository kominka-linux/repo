#!/usr/local/bin/ysh

var name    = 'git'
var ver     = '2.53.0'
var rel     = '8'
var deps    = ['musl', 'curl', 'boringssl', 'zlib']
var mkdeps  = ['zig', 'make']

var sources = [
    'https://mirrors.edge.kernel.org/pub/software/scm/git/git-VERSION.tar.xz',
    'https://mirrors.edge.kernel.org/pub/software/scm/git/git-manpages-VERSION.tar.xz man',
]
var checksums = [
    '5818bd7d80b061bbbdfec8a433d609dc8818a05991f731ffc4a561e2ca18c653',
    '957ffe4409eeb90c7332bff4abee8d5169d28ef5c7c3bf08419f4239be13f77f',
]

proc build(dest) {
    var _kr = ENV => get("KOMINKA_ROOT", "")
    if (_kr === '/') { setvar _kr = '' }

    # Build WITHOUT ./configure — like Alpine.
    # Use the zig cc wrapper (/usr/bin/cc) which includes -target ARCH-linux-musl.
    var CC = $(command -v cc)
    var _inc = "-I${_kr}/usr/include"
    var _libs = "-L${_kr}/usr/lib -lssl -lcrypto"

    # Force NO_REGEX and REGEX_UNDEF_STARTEND into every compilation unit via
    # a pre-include file. CFLAGS/BASIC_CFLAGS override alone isn't reliable
    # because git's Makefile may put these in a different variable than what
    # reaches the final ALL_CFLAGS used for compilation.
    printf '#define NO_REGEX 1\n#define REGEX_UNDEF_STARTEND 1\n' > /tmp/git-no-regex.h

    make \
        CC="$CC" \
        NO_GETTEXT=YesPlease \
        NO_SVN_TESTS=YesPlease \
        NO_TCLTK=YesPlease \
        NO_EXPAT=YesPlease \
        NO_NSEC=YesPlease \
        NO_PYTHON=YesPlease \
        NO_PERL=YesPlease \
        NO_SYS_POLL_H=1 \
        NO_CROSS_DIRECTORY_HARDLINKS=1 \
        NO_INSTALL_HARDLINKS=1 \
        NO_REGEX=NeedsStartEnd \
        prefix=/usr \
        libexecdir=/usr/lib \
        CFLAGS="-Wall -O2 -include /tmp/git-no-regex.h ${_inc}" \
        LDFLAGS="${_libs}" \
        FUZZ_PROGRAMS= \
        all

    make DESTDIR=$dest prefix=/usr libexecdir=/usr/lib install

    # Install manpages.
    if test -d man {
        mkdir -p "${dest}/usr/share/man"
        cp -Rf man "${dest}/usr/share/"
    }
}
