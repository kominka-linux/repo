#!/usr/local/bin/ysh

var name    = 'git'
var ver     = '2.53.0'
var rel     = '15'
var deps    = ['musl', 'curl', 'boringssl', 'zlib']
var mkdeps  = ['zig', 'make']

var sources = [
    'https://mirrors.edge.kernel.org/pub/software/scm/git/git-VERSION.tar.xz',
    'https://mirrors.edge.kernel.org/pub/software/scm/git/git-manpages-VERSION.tar.xz man',
]
var checksums = [
    '5818bd7d80b061bbbdfec8a433d609dc8818a05991f731ffc4a561e2ca18c653',
    '957ffe4409eeb90c7332bff4abee8d5169d28ef5c7c3bf08419f4239be13f77f',
]

proc build(dest) {
    var _kr = ENV => get("KOMINKA_ROOT", "")
    if (_kr === '/') { setvar _kr = '' }

    var CC = $(command -v cc)

    # Include ordering for musl/zig cc:
    # - -Icompat/regex before -I/usr/include: NO_REGEX=NeedsStartEnd adds
    #   -Icompat/regex via COMPAT_CFLAGS. musl lacks REG_STARTEND; with
    #   -Icompat/regex first, #include <regex.h> finds git's bundled
    #   compat/regex/regex.h (which defines REG_STARTEND) not musl's.
    # - -I. before -I/usr/include: git's own tar.h etc. take precedence
    #   over /usr/include/tar.h (which Alpine's musl-dev provides and
    #   lacks TYPEFLAG_GLOBAL_HEADER). -I. is also added by BASIC_CFLAGS
    #   but we need it here first.
    var _inc = "-I${_kr}/usr/include"
    var _libs = "-L${_kr}/usr/lib -lssl -lcrypto"

    make \
        CC="$CC" \
        NO_REGEX=NeedsStartEnd \
        NO_GETTEXT=YesPlease \
        NO_SVN_TESTS=YesPlease \
        NO_TCLTK=YesPlease \
        NO_EXPAT=YesPlease \
        NO_NSEC=YesPlease \
        NO_PYTHON=YesPlease \
        NO_PERL=YesPlease \
        NO_SYS_POLL_H=1 \
        NO_CROSS_DIRECTORY_HARDLINKS=1 \
        NO_INSTALL_HARDLINKS=1 \
        prefix=/usr \
        libexecdir=/usr/lib \
        CFLAGS="-Wall -O2 -DNO_REGEX -Icompat/regex -I. ${_inc}" \
        LDFLAGS="${_libs}" \
        FUZZ_PROGRAMS= \
        all

    make \
        NO_REGEX=NeedsStartEnd \
        prefix=/usr \
        libexecdir=/usr/lib \
        DESTDIR=$dest \
        install

    if test -d man {
        mkdir -p "${dest}/usr/share/man"
        cp -Rf man "${dest}/usr/share/"
    }
}
