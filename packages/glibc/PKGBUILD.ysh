#!/usr/local/bin/ysh

var name    = 'glibc'
var ver     = '2.43'
var rel     = '5'
var deps    = []
var mkdeps  = ['zig', 'make']

var sources = [
    'https://ftp.gnu.org/gnu/glibc/glibc-VERSION.tar.xz',
    'files/cdefs.h',
    'files/queue.h',
    'files/tree.h',
    'files/getconf.c',
    'files/getent.c',
]
var checksums = [
    'd9c86c6b5dbddb43a3e08270c5844fc5177d19442cf5b8df4be7c07cd5fa3831',
    'a83818007069c222d24d283a99348c2376f35bac3282d8142004c47d3dc5ecac',
    'c13407edd0e33be73cae72514cb234f8612e1c0e54401c9448daffd3a240158b',
    'e1e498a79bf160a5766fa560f2b07b206fe89fe21a62600c77d72e00a6992f92',
    '36680bd687848f5fa7a28a02d3a0d2f6d435a2ce797f39c3d0d1b205532ff058',
    'a0cd48081df3442d3f2bee232d5539eca274949f72a38776db661512dc8809db',
]

proc build(dest) {
    var ARCH   = $(uname -m)
    var srcdir = $(pwd)

    # glibc must be built outside its source tree.
    mkdir -p glibc-build
    cd glibc-build

    # CET (Control-flow Enforcement Technology) uses GCC-specific attributes
    # not supported by clang/zig cc on x86_64. Disable it.
    var extra = []
    if (ARCH === 'x86_64') { call extra->append('--disable-cet') }

    # glibc requires GCC: clang/zig cc lacks working alias attribute support.
    # glibc is pure C so GCC-compiled glibc has no libstdc++ runtime dependency.
    env CC=gcc ../configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --enable-bind-now \
        --enable-kernel=5.10 \
        --enable-stack-protector=strong \
        --enable-crypt \
        --disable-nscd \
        --disable-profile \
        --disable-werror \
        @extra \
        libc_cv_slibdir=/usr/lib

    make
    make DESTDIR=$dest install

    # ldd symlink.
    var ldso = ''
    case (ARCH) {
        aarch64 { setvar ldso = 'ld-linux-aarch64.so.1' }
        x86_64  { setvar ldso = 'ld-linux-x86-64.so.2' }
    }
    mkdir -p "${dest}/usr/bin"
    ln -sf "/usr/lib/${ldso}" "${dest}/usr/bin/ldd"

    # Compat symlinks: libdl, libpthread, librt merged into libc in 2.34+.
    for lib in (:| dl pthread rt |) {
        ln -sf libc.so.6 "${dest}/usr/lib/lib${lib}.so.2"
        ln -sf libc.so.6 "${dest}/usr/lib/lib${lib}.so"
    }

    # BSD compatibility headers.
    cp -f "${srcdir}/cdefs.h" "${srcdir}/queue.h" "${srcdir}/tree.h" \
        "${dest}/usr/include/sys"

    # getconf and getent — compile with the same compiler as glibc.
    gcc "${srcdir}/getconf.c" -o "${dest}/usr/bin/getconf"
    gcc "${srcdir}/getent.c"  -o "${dest}/usr/bin/getent"
}
