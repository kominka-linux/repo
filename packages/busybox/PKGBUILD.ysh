#!/usr/local/bin/ysh

var name    = 'busybox'
var ver     = '1.36.1'
var rel     = '11'
var deps    = []
var mkdeps  = ['zig', 'make', 'linux', 'perl']

var sources = [
    'https://busybox.net/downloads/busybox-VERSION.tar.bz2',
    'patches/adduser-no-setgid.patch patch',
    'patches/fsck-resolve-uuid.patch patch',
    'patches/modprobe-kernel-version.patch patch',
    'patches/print-unicode.patch patch',
    'patches/install-fix-chown.patch patch',
    'patches/lsusb-vendor-product.patch patch',
    'patches/unzip-usage-no-error.patch patch',
    'patches/init-use-baseinit.patch patch',
    'patches/fix-UB.patch patch-clang',
    'patches/awk-fix-CVE-2023-42366.patch patch',
    'files/.config',
    'files/.config-suid',
    'files/acpid.run',
    'files/syslogd.run',
    'files/mdev.run',
    'files/ntpd.run',
    'files/mdev.conf',
    'files/getty-hvc0.run',
    'files/getty-tty1.run',
    'files/udhcpc.run',
    'files/udhcpc.ysh',
]
var checksums = [
    'b8cc24c9574d809e7279c3be349795c5d5ceb6fdf19ca709f80cde50e47de314',
    '09c2f601fec4e5c10664c22f787dafb9424efe219bf826727c356da90dfd60d5',
    '8d84b1719dca2a751c09072c20cd782a3c47f119a68d35316f89d851daf67b88',
    '0f54301a73af461e8066bc805b48d991cfed513d08a2f036e015b19f97cb424a',
    '68e0c7d5e96902d3b890e89d9b018ae11d53ed3104bfedd624a1485df58b11cb',
    'f0e17fefc0af6b10205d72b242b6ef7481a58ff07726c62890ebc5893b96a396',
    '73be7b16dcff44e88eb48696522794f529beddf9d5a139b8a76cc8685a9f6fc8',
    'd70c4cd6381baeb3836c0387f53553021b48bdc851de49f1c86d836f7d0355fc',
    'b030d6ac2b3284cf3cc0a2eec886d26b7e09ea59feb460a6a09165da62a582b4',
    'c8a6fc95a75fa355d570c14e214d68a618e060a486b824b83b5140b9c6a894a7',
    '34a52455ba3866c43d53558047fa40edba5118218930a3f860d1d343dc7d09a8',
    '96d8847221f71b4100cfb94a1e98307651cd6386acb473768383273cf1e56f26',
    '9e21039ef69464ab4abd4aa81953ea67c75511fe624b9a4e0ce4767741110512',
    '2734d31e2ec590b9a5be4a7330ad9b512b60fcf3e9ff58d6fbea13f28f01717e',
    'eb1bd80eff850dc469c6b89019352c4026397dd263b9d86834c34df295a7fd47',
    'f1de219edef2cfcd04ccf3482a93d9c2bca9afd844e5f1f125d19fc791ee1dab',
    '898a50dda6b2bf16892697cc26e6268388ebfde698f04c6d8467317aa76b4d04',
    '5ea98cc467b258c8c75e2a4e440bea509640954fe80e832cfa5e83d25a1bf3a8',
    'b27164ddb8d42a4b37768f270665fb9f48ccf879bcb28f0ed0aacce2c0517272',
    'b97efe82ead30cb551aa8848168507c9019c0bdeb442a29a464117948b8520eb',
    '971e546215f013678c96fff910d71224ea085eea5ad82d5d88fbe2205316e709',
    '89d3c2954ca89943b740d14ad5fab9ef5a85fbb7a8b60c9b579a542dd486be75',
]

proc build(dest) {
    var CC = ENV => get("CC", "cc")
    # HOSTCC builds host tools (fixdep, etc.) that run during the build.
    # Use system gcc when available — zig-compiled host tools crash under QEMU.
    var HOSTCC = CC
    try { command -v gcc >/dev/null 2>&1 }
    if ! failed { setvar HOSTCC = 'gcc' }

    # CONFIG_USE_BB_CRYPT=y means busybox provides its own crypt — no libcrypt
    # dep at runtime. But make oldconfig re-adds -lcrypt to config.mak.autogen
    # based on system detection even with USE_BB_CRYPT=y. glibc 2.43+ removed
    # libcrypt, so the .so doesn't exist and zig's strict linker errors.
    # Create an empty static libcrypt.a so -lcrypt is satisfied at link time
    # without adding a NEEDED entry (static libs don't create NEEDED entries).
    touch /tmp/_crypt_empty.c
    $CC -c /tmp/_crypt_empty.c -o /tmp/_crypt_empty.o 2>/dev/null || true
    ar rcs /usr/lib/libcrypt.a /tmp/_crypt_empty.o 2>/dev/null || true
    rm -f /tmp/_crypt_empty.c /tmp/_crypt_empty.o

    for patch in @[glob('patch/*.patch')] {
        patch -p1 < $patch
    }

    # Remove forced gcc/g++ usage so builds work on gcc-less systems.
    var sed1 = "s#= g[c+][c+]#= ${CC}#g"
    var _pre2 = r's#\(\$(CROSS_COMPILE)\)gcc#\1'
    var sed2 = "${_pre2}${CC}#g"
    sed -e $sed1 -e $sed2 Makefile > _
    mv -f _ Makefile

    var cc_ver = $($CC --version)
    if (cc_ver => contains('clang')) {
        # Disable UB based optimizations which are optimized out by
        # clang and become null pointer dereferences.
        patch -p1 --ignore-whitespace -F3 < patch-clang/fix-UB.patch || true

        var _pre3 = r's&\(\$(CC),\)clang&\1'
        var sed3 = "${_pre3}${CC}&g"
        sed $sed3 Makefile.flags > _
        mv -f _ Makefile.flags

        # Strip linker flags unsupported by lld (zig's linker).
        # Also strip -lcrypt: not bundled in glibc 2.43+, and USE_BB_CRYPT=y
        # means busybox has its own crypt implementation.
        sed -e 's/-Wl,--warn-common//g' \
            -e 's/-Wl,-Map,[^ ]*//g' \
            -e 's/-Wl,--verbose//g' \
            -e 's/-lcrypt//g' \
            scripts/trylink > _
        mv -f _ scripts/trylink
        chmod +x scripts/trylink
    }

    # For non-clang builds, also strip -lcrypt from trylink.
    try {
        sed -i 's/-lcrypt//g' scripts/trylink
    }

    # SKIP_STRIP=y: busybox Makefile uses strip -o (output to new file),
    # which our strip doesn't support. pm's pkg_strip runs after build.
    # olddefconfig resolves any new config options without interactive prompts.
    # Use yes to auto-answer new config prompts (busybox oldconfig may ask
    # about new options not in the saved .config).
    # libcrypt is no longer bundled in glibc 2.43+; busybox uses its own
    # crypt (USE_BB_CRYPT=y) so strip the -lcrypt link flag everywhere.
    try { grep -rl -- -lcrypt . 2>/dev/null | xargs sed -i 's/-lcrypt//g' }
    # Settle any new config symbols before the main build. Run oldconfig
    # until no NEW symbols remain; silentoldconfig aborts otherwise.
    while true {
        var _out = $(yes '' | make HOSTCC=$HOSTCC SHELL=/usr/local/bin/ysh oldconfig 2>&1 || true)
        if ! (echo $_out | grep -q '(NEW)') { break }
    }
    # oldconfig regenerates config.mak.autogen which may re-add -lcrypt.
    # Strip it again after oldconfig so zig's strict linker doesn't fail.
    try { grep -rl -- -lcrypt . 2>/dev/null | xargs sed -i 's/-lcrypt//g' }
    # tc.c references TCA_CBQ_MAX/TCA_CBQ_RATE etc. which were removed in
    # Linux 6.x. Guard against oldconfig re-enabling TC by removing tc.o
    # from the networking Makefile entirely.
    try { sed -i 's/^lib-\$(CONFIG_TC) += tc\.o//' networking/Makefile }
    make HOSTCC=$HOSTCC SHELL=/usr/local/bin/ysh SKIP_STRIP=y
    make HOSTCC=$HOSTCC SHELL=/usr/local/bin/ysh CONFIG_PREFIX="${dest}/usr" install

    # Rename the binary temporarily.
    mv "${dest}/usr/bin/busybox" "${dest}/usr/bin/busybox-nosuid"

    # Build and install suid busybox.
    cp -f .config-suid .config
    while true {
        var _out = $(yes '' | make HOSTCC=$HOSTCC SHELL=/usr/local/bin/ysh oldconfig 2>&1 || true)
        if ! (echo $_out | grep -q '(NEW)') { break }
    }
    try { grep -rl -- -lcrypt . 2>/dev/null | xargs sed -i 's/-lcrypt//g' }
    make HOSTCC=$HOSTCC SHELL=/usr/local/bin/ysh SKIP_STRIP=y
    make HOSTCC=$HOSTCC SHELL=/usr/local/bin/ysh CONFIG_PREFIX="${dest}/usr" install

    # Aptly name the busybox binaries.
    mv -f "${dest}/usr/bin/busybox"        "${dest}/usr/bin/busybox-suid"
    mv -f "${dest}/usr/bin/busybox-nosuid" "${dest}/usr/bin/busybox"

    # Install the non-suid symlinks.
    try {
        "${dest}/usr/bin/busybox" --list | while read -r bin {
            ln -s busybox "${dest}/usr/bin/${bin}" 2>/dev/null
        }
    }

    # Install the suid symlinks.
    try {
        "${dest}/usr/bin/busybox-suid" --list | while read -r bin {
            ln -s busybox-suid "${dest}/usr/bin/${bin}" 2>/dev/null
        }
    }

    chmod u+s "${dest}/usr/bin/busybox-suid"

    mkdir -p "${dest}/etc/acpi"

    # Install runit services.
    for s in (:| acpid syslogd mdev ntpd udhcpc getty-hvc0 getty-tty1 |) {
        mkdir -p "${dest}/etc/sv/${s}"
        cp -f "${s}.run" "${dest}/etc/sv/${s}/run"
        chmod +x "${dest}/etc/sv/${s}/run"
        ln -sf "/run/runit/supervise.${s}" "${dest}/etc/sv/${s}/supervise"
    }

    cp -f mdev.conf "${dest}/etc/mdev.conf"

    # udhcpc lease script.
    mkdir -p "${dest}/etc"
    cp -f udhcpc.ysh "${dest}/etc/udhcpc.sh"
    chmod +x "${dest}/etc/udhcpc.sh"
}
