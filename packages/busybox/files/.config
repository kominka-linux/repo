# Kominka busybox configuration — minimal explicit whitelist.
# Only applets needed by the system are enabled.
# After editing, regenerate checksums: pm c busybox

CONFIG_BUSYBOX=y
CONFIG_BUSYBOX_EXEC_PATH="/proc/self/exe"

# ── Build settings ─────────────────────────────────────────────────────────
CONFIG_DESKTOP=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_LFS=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
CONFIG_MONOTONIC_SYSCALL=y
CONFIG_UNICODE_SUPPORT=y
CONFIG_INCLUDE_SUSv2=y
CONFIG_FEATURE_COPYBUF_KB=4
CONFIG_STACK_OPTIMIZATION_386=y
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
CONFIG_NO_DEBUG_LIB=y
CONFIG_MATH_SUPPORT=y
CONFIG_EXPR_MATH_SUPPORT_64=y
CONFIG_USE_PORTABLE_CODE=y
CONFIG_INSTALL_APPLET_DONT=y
CONFIG_IOCTL_HEX2STR_ERROR=y
CONFIG_TRY_LOOP_CONFIGURE=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_FLOAT_DURATION=y

# ── Hashing (pm checksum verification) ────────────────────────────────────
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y
CONFIG_SHA256SUM=y
CONFIG_SHA512SUM=y
CONFIG_SHA1_HWACCEL=y
CONFIG_SHA256_HWACCEL=y
CONFIG_SHA3_SMALL=1

# ── Shell ──────────────────────────────────────────────────────────────────
CONFIG_SHELL_ASH=y
CONFIG_ASH=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_IDLE_TIMEOUT=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_MAIL=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_HELP=y
CONFIG_ASH_RANDOM_SUPPORT=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_BASH_NOT_FOUND_HOOK=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_SLEEP=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_VI=y
CONFIG_FEATURE_EDITING_HISTORY=255
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_EDITING_USERNAME_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_EDITING_ASK_TERMINAL=y
CONFIG_FEATURE_TAB_COMPLETION=y

# ── Core filesystem utilities ──────────────────────────────────────────────
CONFIG_CAT=y
CONFIG_CHGRP=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CHROOT=y
CONFIG_CP=y
CONFIG_DD=y
CONFIG_DF=y
CONFIG_DU=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_FALSE=y
CONFIG_FIND=y
