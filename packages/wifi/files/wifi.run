#!/usr/local/bin/ysh
# runit service: wifi
# Runs wpa_supplicant for the configured interface; wpa_supplicant calls
# /usr/lib/wifi/action.sh on CONNECTED/DISCONNECTED to drive udhcpc.

if ! test -f /etc/wifi.conf { exec sv stop wifi }

source /etc/wifi.conf
if (IFACE === '') { exec sv stop wifi }

# Regenerate wpa_supplicant.conf if wifi.conf is newer (password change etc.).
if ! test -f /etc/wpa_supplicant.conf || test /etc/wifi.conf -nt /etc/wpa_supplicant.conf {
    {
        echo 'ctrl_interface=/run/wpa_supplicant'
        echo 'ctrl_interface_group=0'
        wpa_passphrase $SSID $PSK | grep -v '#psk='
    } > /etc/wpa_supplicant.conf
    chmod 600 /etc/wpa_supplicant.conf
}

mkdir -p /run/wpa_supplicant
ip link set $IFACE up

# Run wpa_supplicant in the foreground; runit supervises it.
# -a: action script called on CONNECTED/DISCONNECTED events.
exec wpa_supplicant -D nl80211 -i $IFACE \
    -c /etc/wpa_supplicant.conf \
    -a /usr/lib/wifi/action.sh
