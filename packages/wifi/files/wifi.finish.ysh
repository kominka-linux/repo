#!/usr/local/bin/ysh
# runit finish script for the wifi service.
# Called when wpa_supplicant exits (crash, card removed, etc.).
# Kill udhcpc so we don't leave a DHCP client with no underlying link.

if ! builtin test -f /etc/wifi.conf { exit 0 }
builtin source /etc/wifi.conf
if (IFACE === '') { exit 0 }

var pid_file = "/run/udhcpc-${IFACE}.pid"
if builtin test -f $pid_file {
    seed kill $(seed cat $pid_file) 2>/dev/null || builtin true
}
seed rm -f $pid_file
seed ip addr flush dev $IFACE 2>/dev/null || builtin true
