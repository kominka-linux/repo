#!/usr/local/bin/ysh

var name    = 'wifi'
var ver     = '1.0.0'
var rel     = '4'
var deps    = ['wpa_supplicant', 'seed', 'ysh']
var mkdeps  = []

var sources = [
    'files/wifi-setup',
    'files/action.ysh',
    'files/wifi.run',
    'files/wifi.finish.ysh',
]
var checksums = [
    '660f1dea106ac35de06ec8ff4f4bb4279cef67c78b8131bd1dd7636aba90c726',
    '98e0ef47ed4269410fb23ac07e1c8da8a8ee869bdae598665fd7064ed23ef935',
    '40cff5755dacc0f7e883382756e2fd5d36c7c2c5c01ebb2b9b731ae934e98d2c',
    '8d930b359baedd3eb62b4e5111b9ed82fbe171d2358fb4fa3c5001c49ea7cf23',
]

proc build(dest) {

    seed mkdir -p \
        "${dest}/usr/bin" \
        "${dest}/usr/lib/wifi" \
        "${dest}/etc/sv/wifi"

    seed install -m755 wifi-setup   "${dest}/usr/bin/wifi-setup"
    seed install -m755 action.ysh    "${dest}/usr/lib/wifi/action.sh"
    seed install -m755 wifi.run     "${dest}/etc/sv/wifi/run"
    seed install -m755 wifi.finish.ysh  "${dest}/etc/sv/wifi/finish"

    seed ln -sf "/run/runit/supervise.wifi" "${dest}/etc/sv/wifi/supervise"
}
