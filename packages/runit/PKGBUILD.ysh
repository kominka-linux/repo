#!/usr/local/bin/ysh

var name    = 'runit'
var ver     = '2.3.1'
var rel     = '2'
var deps    = ['musl']
var mkdeps  = ['zig', 'make']

var sources = ['http://smarden.org/runit/runit-VERSION.tar.gz']
var checksums = ['634f23c8c4d1d440043be0fe928ddf904626289e97bfe7c5826e93aaf2cc6fe9']

proc build(dest) {
    var CC = ENV => get("CC", "cc")

    builtin cd runit-2.3.1

    # Override compiler and linker.
    # -D_GNU_SOURCE exposes setgroups() in the libc headers.
    # -Wno-implicit-function-declaration tolerates runit's old C style.
    builtin printf '%s\n' "${CC} -O2 -Wall -D_GNU_SOURCE -Wno-implicit-function-declaration -Wno-incompatible-pointer-types" > src/conf-cc
    builtin printf '%s\n' "${CC} -s" > src/conf-ld

    # seed head doesn't support -n; patch scripts to use the traditional form.
    seed sed -i 's/head -n1/head -1/g' src/print-cc.sh src/print-ld.sh

    # runit defaults to -static; remove it for dynamic linking.
    seed sed -i 's/ -static//g' src/Makefile

    # Build using runit's own build system.
    package/compile

    # Install supervision binaries.
    seed mkdir -p "${dest}/usr/bin"
    for bin in (:| chpst runsv runsvdir sv svlogd |) {
        seed cp -f "command/${bin}" "${dest}/usr/bin/"
    }
}
