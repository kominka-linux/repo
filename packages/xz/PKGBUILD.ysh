#!/usr/local/bin/ysh

var name    = 'xz'
var ver     = '5.8.3'
var rel     = '4'
var deps    = []
var mkdeps  = ['zig', 'make']

var sources = ['https://github.com/tukaani-project/xz/releases/download/vVERSION/xz-VERSION.tar.xz']
var checksums = ['fff1ffcf2b0da84d308a14de513a1aa23d4e9aa3464d17e64b9714bfdd0bbfb6']

proc build(dest) {
    var zig_bin = $(command -v zig)

    # CFLAGS=-O1: lld 20.x enforces strict aarch64 alignment for R_AARCH64_LDST32
    # relocations. -O2 generates vectorized loads that hit unaligned addresses
    # in xz's args.c; -O1 avoids those patterns.
    env CC="$zig_bin cc" CFLAGS="-O1" ./configure \
        --prefix=/usr \
        --disable-doc \
        --disable-nls

    make
    make DESTDIR=$dest install
}
