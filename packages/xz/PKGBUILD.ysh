#!/usr/local/bin/ysh

var name    = 'xz'
var ver     = '5.8.3'
var rel     = '5'
var deps    = []
var mkdeps  = ['zig', 'make']

var sources = ['https://github.com/tukaani-project/xz/releases/download/vVERSION/xz-VERSION.tar.xz']
var checksums = ['fff1ffcf2b0da84d308a14de513a1aa23d4e9aa3464d17e64b9714bfdd0bbfb6']

proc build(dest) {
    var zig_bin = $(command -v zig)

    # CFLAGS: lld 20.x enforces strict aarch64 R_AARCH64_LDST32_ABS_LO12_NC
    # alignment. The offending data in args.c is a static item placed at a
    # 2-byte-aligned address. -O0 avoids the 32-bit direct address patterns
    # that trigger lld's check (while -O1 still generates them).
    env CC="$zig_bin cc" CFLAGS="-O0" ./configure \
        --prefix=/usr \
        --disable-doc \
        --disable-nls

    make
    make DESTDIR=$dest install
}
