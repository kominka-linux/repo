#!/usr/local/bin/ysh

var name    = 'm4'
var ver     = '1.4.21'
var rel     = '4'
var deps    = ['musl']
var mkdeps  = ['zig', 'make']

var sources = ['https://ftp.gnu.org/gnu/m4/m4-VERSION.tar.xz']
var checksums = ['f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66']

proc build(dest) {
    var zig_bin = $(command -v zig)

    # EGREP: busybox egrep may not accept -e flag that autoconf checks for.
    # busybox egrep rejects -e/-E flags; autoconf tests "egrep -Ee pattern".
    # Wrapper strips any arg starting with -e or -E (redundant since grep -E
    # is already extended regex), keeps everything else including bare -.
    printf '#!/bin/sh\nargs=\nfor a in "$@"; do\n  case "$a" in -[eE]*) ;; *) args="$args $a";; esac\ndone\nexec grep -E $args\n' > /tmp/egrep
    chmod +x /tmp/egrep
    env CC="$zig_bin cc" PATH="/tmp:$PATH" ./configure \
        --prefix=/usr

    # Fix gnulib _GL_ATTRIBUTE_NODISCARD incompatibility with newer GCC.
    find lib -name '*.h' -exec sed -i \
        's/^\(# *define _GL_ATTRIBUTE_NODISCARD\) .*/\1/' {} +

    make
    make DESTDIR=$dest install
}
