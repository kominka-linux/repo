#!/usr/local/bin/ysh

var name    = 'm4'
var ver     = '1.4.21'
var rel     = '4'
var deps    = ['musl']
var mkdeps  = ['zig', 'make']

var sources = ['https://ftp.gnu.org/gnu/m4/m4-VERSION.tar.xz']
var checksums = [
    'f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66',
]

proc build(dest) {
# EGREP_TRADITIONAL and GREP: if these env vars are non-empty, configure
# skips the tool-detection tests entirely. Avoids seed egrep -Ee failure.
# --disable-dependency-tracking + --disable-nls: reduce substitutions in
# config.status; seed sed fails on the full gnulib-generated set.
# Use system cc (/usr/bin/cc, the zig wrapper with -target ARCH-linux-musl)
# rather than raw zig cc: the wrapper targets the correct arch, so configure
# conftest programs execute without SIGILL.
setglobal ENV.EGREP_TRADITIONAL = 'egrep'
setglobal ENV.GREP = 'grep'
./configure \
--prefix=/usr \
--disable-dependency-tracking \
--disable-nls

# Same autotools timestamp cascade as make: sources are newer than derived
# outputs in the tarball; override the tools so recursive makes don't fail.
sed -i '/^@MAINT_MAKEFILE@$/d' Makefile
touch Makefile

# Stub doc/ and checks/: no help2man, makeinfo, or gnulib test infra available.
# Stubbing Makefile.in ensures config.status regeneration also produces a stub.
for d in doc checks; do
    printf 'all m4.1 stamp-checks:\n\t@:\ninstall install-data install-exec install-man install-binPROGRAMS am--refresh Makefile:\n\t@:\n' > $d/Makefile
    printf 'all m4.1 stamp-checks:\n\t@:\ninstall install-data install-exec install-man install-binPROGRAMS am--refresh Makefile:\n\t@:\n' > $d/Makefile.in
done

# Fix gnulib _GL_ATTRIBUTE_NODISCARD incompatibility with newer GCC.
seed find lib -name '*.h' -exec sed -i \
's/^\(# *define _GL_ATTRIBUTE_NODISCARD\) .*/\1/' {} +

make SUBDIRS='lib src' \
ACLOCAL=true AUTOCONF=true AUTOMAKE=true AUTOHEADER=true MAKEINFO=true HELP2MAN=true

make -C src DESTDIR=$dest \
ACLOCAL=true AUTOCONF=true AUTOMAKE=true AUTOHEADER=true MAKEINFO=true HELP2MAN=true \
install-binPROGRAMS
}
