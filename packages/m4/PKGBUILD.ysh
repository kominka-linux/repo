#!/usr/local/bin/ysh

var name    = 'm4'
var ver     = '1.4.21'
var rel     = '4'
var deps    = ['musl']
var mkdeps  = ['zig', 'make']

var sources = ['https://ftp.gnu.org/gnu/m4/m4-VERSION.tar.xz']
var checksums = ['f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66']

proc build(dest) {
    var zig_bin = $(command -v zig)

    # EGREP: busybox egrep may not accept -e flag that autoconf checks for.
    # busybox egrep rejects -e/-E flags; autoconf/gnulib tests "egrep -Ee".
    # Set all candidate cache variables (gnulib uses gl_cv_ prefix).
    grep -r "checking for egrep" ../configure 2>/dev/null | head -3
    var=$(grep -o 'ac_cv_prog_egrep\|gl_cv_prog_egrep\|gl_cv_path_EGREP\|ac_cv_path_EGREP' ../configure 2>/dev/null | sort -u | head -1)
    echo "egrep cache var: $var"
    printf 'ac_cv_prog_egrep=egrep\ngl_cv_prog_egrep=egrep\ngl_cv_path_EGREP=egrep\nac_cv_path_EGREP=egrep\n' > config.cache
    env CC="$zig_bin cc" ./configure \
        --cache-file=config.cache \
        --prefix=/usr

    # Fix gnulib _GL_ATTRIBUTE_NODISCARD incompatibility with newer GCC.
    find lib -name '*.h' -exec sed -i \
        's/^\(# *define _GL_ATTRIBUTE_NODISCARD\) .*/\1/' {} +

    make
    make DESTDIR=$dest install
}
