#!/usr/local/bin/ysh

var name    = 'm4'
var ver     = '1.4.21'
var rel     = '4'
var deps    = ['musl']
var mkdeps  = ['zig', 'make']

var sources = ['https://ftp.gnu.org/gnu/m4/m4-VERSION.tar.xz']
var checksums = ['f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66']

proc build(dest) {
    var zig_bin = $(command -v zig)

    # EGREP: busybox egrep may not accept -e flag that autoconf checks for.
    # busybox egrep rejects -e; autoconf's AC_PROG_EGREP tests egrep -e pattern.
    # Wrapper strips -e (redundant for egrep which is already extended) then
    # calls grep -E. Placed as "egrep" in PATH so autoconf finds it directly.
    printf '#!/bin/sh\ncase "$1" in -e) shift;; esac\nexec grep -E "$@"\n' > /tmp/egrep
    chmod +x /tmp/egrep
    env CC="$zig_bin cc" PATH="/tmp:$PATH" ./configure \
        --prefix=/usr

    # Fix gnulib _GL_ATTRIBUTE_NODISCARD incompatibility with newer GCC.
    find lib -name '*.h' -exec sed -i \
        's/^\(# *define _GL_ATTRIBUTE_NODISCARD\) .*/\1/' {} +

    make
    make DESTDIR=$dest install
}
