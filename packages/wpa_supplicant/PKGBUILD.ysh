#!/usr/local/bin/ysh

var name    = 'wpa_supplicant'
var ver     = '2.11'
var rel     = '9'
var deps    = ['musl', 'libnl']
var mkdeps  = ['zig', 'make']

var sources = [
    'https://w1.fi/releases/wpa_supplicant-VERSION.tar.gz',
    'files/.config',
]
var checksums = [
    '912ea06f74e30a8e36fbb68064d6cdff218d8d591db0fc5d75dee6c81ac7fc0a',
    '6ca881160e858c425381044dc8875644f4f89fc47f9d1b9074d1f9b868ecdea3',
]

proc build(dest) {
    var _kr = ENV => get("KOMINKA_ROOT", "")
    if (_kr === '/') { setvar _kr = '' }

    var CC = ENV => get("CC", "cc")

    cd wpa_supplicant

    # pm strips the 'files/' prefix when copying local sources, so .config
    # lands at the root of the build directory (one level above wpa_supplicant/).
    cp -f ../.config .config

    # Isolate libnl into a temp dir so -L only pulls in libnl, not all of
    # KOMINKA_ROOT/usr/lib (which would bring in musl's libc.so etc.).
    var _libnl_dir = "/tmp/wpa-libnl-$$"
    mkdir -p $_libnl_dir
    ln -sf "${_kr}/usr/lib/libnl-3.so"      "${_libnl_dir}/"
    ln -sf "${_kr}/usr/lib/libnl-genl-3.so" "${_libnl_dir}/"

    # CFLAGS via environment so the Makefile's CFLAGS += additions survive.
    # Command-line CFLAGS= would override them, breaking wpa_supplicant's
    # own -I../src -I../src/utils include paths.
    var CFLAGS = ENV => get("CFLAGS", "-O2 -DNDEBUG")
    setglobal ENV.CFLAGS = "${CFLAGS} -I${_kr}/usr/include/libnl3"

    PKG_CONFIG_PATH="${_kr}/usr/lib/pkgconfig" \
    make -j$(nproc) \
        CC=$CC \
        LDFLAGS="-L${_libnl_dir}"

    install -Dm755 wpa_supplicant   "${dest}/usr/sbin/wpa_supplicant"
    install -Dm755 wpa_cli          "${dest}/usr/sbin/wpa_cli"
    install -Dm755 wpa_passphrase   "${dest}/usr/bin/wpa_passphrase"

    rm -rf $_libnl_dir
}
