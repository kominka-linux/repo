#!/usr/local/bin/ysh

var name    = 'wpa_supplicant'
var ver     = '2.11'
var rel     = '6'
var deps    = ['glibc', 'libnl']
var mkdeps  = ['zig', 'make']

var sources = [
    'https://w1.fi/releases/wpa_supplicant-VERSION.tar.gz',
    'files/.config',
]
var checksums = [
    '912ea06f74e30a8e36fbb68064d6cdff218d8d591db0fc5d75dee6c81ac7fc0a',
    '1c94f3357bebbb629288f4a92de8afde30e0fda5fbe89ae9828ce61cd9932c4b',
]

proc build(dest) {
    var _kr = ENV => get("KOMINKA_ROOT", "")
    if (_kr === '/') { setvar _kr = '' }

    var CC = ENV => get("CC", "cc")

    cd wpa_supplicant

    # pm strips the 'files/' prefix when copying local sources, so .config
    # lands at the root of the build directory (one level above wpa_supplicant/).
    cp -f ../.config .config

    var _pc = "${_kr}/usr/lib/pkgconfig"

    # Set CFLAGS/LDFLAGS in the environment, NOT on the command line.
    # Command-line make CFLAGS=... overrides the Makefile's CFLAGS += additions
    # (like -I../src -I../src/utils), breaking wpa_supplicant's own includes.
    # Environment vars are preserved because Makefile does: CFLAGS += -I../src
    # which APPENDS to whatever was already in CFLAGS from the environment.
    var CFLAGS  = ENV => get("CFLAGS", "-O2 -DNDEBUG")
    var LDFLAGS = ENV => get("LDFLAGS", "")
    setglobal ENV.CFLAGS  = "${CFLAGS} -I${_kr}/usr/include"
    setglobal ENV.LDFLAGS = "${LDFLAGS} -L${_kr}/usr/lib"

    PKG_CONFIG_PATH=$_pc \
    PKG_CONFIG_SYSROOT_DIR=$_kr \
    make -j$(nproc) CC=$CC

    install -Dm755 wpa_supplicant   "${dest}/usr/sbin/wpa_supplicant"
    install -Dm755 wpa_cli          "${dest}/usr/sbin/wpa_cli"
    install -Dm755 wpa_passphrase   "${dest}/usr/bin/wpa_passphrase"
}
