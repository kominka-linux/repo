# wpa_supplicant build config — WPA2/WPA3-PSK only, no TLS/EAP.
# Internal crypto only; no OpenSSL dependency.

CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

CONFIG_WPA=y
CONFIG_RSN_PREAUTH=y
CONFIG_CCMP=y
CONFIG_TKIP=y
CONFIG_SAE=y

# Use wpa_supplicant's own TLS implementation — no OpenSSL needed.
# CONFIG_TLS=none breaks SHA1 linking; internal self-consistently wires
# all crypto primitives without external libraries.
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y

# Internal crypto — no OpenSSL needed for PSK mode
CONFIG_INTERNAL_AES=y
CONFIG_INTERNAL_MD5=y
CONFIG_INTERNAL_SHA1=y
CONFIG_INTERNAL_SHA256=y
CONFIG_INTERNAL_SHA384=y
CONFIG_INTERNAL_SHA512=y

# Unix domain socket for wpa_cli
CONFIG_CTRL_IFACE=y

# Build helper tools
CONFIG_WPA_PASSPHRASE=y
CONFIG_WPA_CLI=y

# Explicitly disable everything enterprise / advanced
CONFIG_EAP_MD5=
CONFIG_EAP_MSCHAPV2=
CONFIG_EAP_TLS=
CONFIG_EAP_PEAP=
CONFIG_EAP_TTLS=
CONFIG_EAP_GTC=
CONFIG_EAP_OTP=
CONFIG_EAP_LEAP=
CONFIG_EAP_PSK=
CONFIG_EAP_SAKE=
CONFIG_EAP_GPSK=
CONFIG_EAP_PWD=
CONFIG_EAP_PAX=
CONFIG_EAP_VENDOR_TEST=
CONFIG_WPS=
CONFIG_P2P=
CONFIG_WIFI_DISPLAY=
CONFIG_IBSS_RSN=
CONFIG_AP=
CONFIG_MESH=
CONFIG_FILS=
CONFIG_OWE=
CONFIG_DPP=
CONFIG_INTERWORKING=
CONFIG_PCSC=
CONFIG_SMARTCARD=
CONFIG_EAP_PROXY=
CONFIG_NO_RANDOM_POOL=
