# wpa_supplicant build config — WPA2-PSK only, no external SSL dependency.
#
# CONFIG_TLS=internal uses wpa_supplicant's own TLS/crypto stack:
# - All crypto (SHA1, AES, MD5, SHA256) comes from wpa_supplicant itself
# - CONFIG_INTERNAL_LIBTOMMATH uses the bundled bignum library
# - No OpenSSL, GnuTLS, or BoringSSL dep at build or runtime
# - WPA2-PSK and WPA3-SAE are NOT included (SAE needs DH ops that require
#   the internal TLS stack extensions beyond the minimal config here)
#
# Runtime deps: glibc + libnl only.

CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

CONFIG_WPA=y
CONFIG_RSN_PREAUTH=y
CONFIG_CCMP=y
CONFIG_TKIP=y

CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y

# Unix domain socket control interface (required for wpa_cli)
CONFIG_CTRL_IFACE=y

# Helper tools
CONFIG_WPA_PASSPHRASE=y
CONFIG_WPA_CLI=y
