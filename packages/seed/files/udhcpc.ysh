#!/usr/local/bin/ysh
# udhcpc script — called by udhcpc on lease events.
# $1 = event (bound, renew, deconfig), env vars set by udhcpc.

var event = $1
var iface  = ENV => get("interface", "")
var ip_    = ENV => get("ip", "")
var mask   = ENV => get("mask", "24")
var router = ENV => get("router", "")
var dns_   = ENV => get("dns", "")

case (event) {
    bound|renew {
        seed ip addr flush dev $iface
        seed ip addr add "${ip_}/${mask}" dev $iface
        if (router !== '') { seed ip route add default via $router dev $iface }
        if (dns_ !== '') {
            builtin true > /etc/resolv.conf
            for ns in @[split(dns_)] {
                builtin echo "nameserver $ns" >> /etc/resolv.conf
            }
        }
        # Signal that the network is up for dependent services (ntpd etc.).
        seed mkdir -p /run
        builtin true > /run/network-up
    }
    deconfig {
        seed ip addr flush dev $iface
        seed rm -f /run/network-up
    }
}
