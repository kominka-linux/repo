#!/usr/local/bin/ysh

var name    = 'musl'
var ver     = '1.2.6'
var rel     = '15'
var deps    = []
var mkdeps  = ['zig']
var nostrip = true  # strip removes dynamic symbols needed by the runtime linker

var sources = [
    'https://musl.libc.org/releases/musl-VERSION.tar.gz',
    'patches/ld-so-preload.patch patch',
]
var checksums = [
    'd585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a',
    'af99fd5b5861cb1aa65e2af14419a321118365d776206171764c5a01310082b1',
]

proc build(dest) {
    var ARCH   = $(uname -m)
    var zig_bin = $(command -v zig)

    # Add /etc/ld.so.preload support to the dynamic linker.
    patch -p1 < patch/ld-so-preload.patch

    mkdir -p musl-build
    cd musl-build

    env CC="$zig_bin cc" ../configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --syslibdir=/usr/lib \
        --disable-gcc-wrapper

    sed -i 's/-Wl,--gc-sections//' config.mak
    # -U_FORTIFY_SOURCE: zig cc enables _FORTIFY_SOURCE by default, which injects
    # LOCAL __memcpy_chk wrappers that can shadow the assembly GLOBAL memcpy.
    sed -i 's|^CFLAGS_AUTO = |CFLAGS_AUTO = -U_FORTIFY_SOURCE |' config.mak

    make
    make DESTDIR=$dest install

    # ldd symlink.
    var ldso = ''
    case (ARCH) {
        aarch64 { setvar ldso = 'ld-musl-aarch64.so.1' }
        x86_64  { setvar ldso = 'ld-musl-x86_64.so.1' }
    }
    if (ldso !== '') {
        # musl installs ld-musl-*.so.1 as a hard link to libc.so.
        # Replace with a symlink so the relationship survives packaging/tar.
        ln -sf libc.so "${dest}/usr/lib/${ldso}"
    }
    mkdir -p "${dest}/usr/bin"
    ln -sf "/usr/lib/${ldso}" "${dest}/usr/bin/ldd"
}
