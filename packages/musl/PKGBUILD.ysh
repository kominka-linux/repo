#!/usr/local/bin/ysh

var name    = 'musl'
var ver     = '1.2.6'
var rel     = '17'
var deps    = []
var mkdeps  = ['zig']
var nostrip = true  # strip removes dynamic symbols needed by the runtime linker

var sources = [
    'https://musl.libc.org/releases/musl-VERSION.tar.gz',
    'patches/ld-so-preload.patch patch',
    'files/float128_shim.c',
]
var checksums = [
    'd585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a',
    'af99fd5b5861cb1aa65e2af14419a321118365d776206171764c5a01310082b1',
    '8b7a77a46f59ea4dc2ec5d9a948b07a4fad2b5001b7473614f271bba20dafb44',
]

proc build(dest) {
    var ARCH   = $(uname -m)
    var zig_bin = $(command -v zig)

    # Add /etc/ld.so.preload support to the dynamic linker.
    patch -p1 < patch/ld-so-preload.patch

    mkdir -p musl-build
    cd musl-build

    env CC="$zig_bin cc" ../configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --syslibdir=/usr/lib \
        --disable-gcc-wrapper

    sed -i 's/-Wl,--gc-sections//' config.mak
    # -U_FORTIFY_SOURCE: zig cc enables _FORTIFY_SOURCE by default, which injects
    # LOCAL __memcpy_chk wrappers that can shadow the assembly GLOBAL memcpy.
    sed -i 's|^CFLAGS_AUTO = |CFLAGS_AUTO = -U_FORTIFY_SOURCE |' config.mak

    # Replace the libc.so link recipe with zig ld.lld directly, bypassing zig cc
    # as link driver (which injects ubsan_rt and demotes memcpy to LOCAL HIDDEN).
    # CRITICAL: target ../Makefile — musl-build/Makefile is only a thin wrapper
    # ("include ../Makefile"); the actual libc.so recipe lives in the source tree.
    # compiler_rt defines memcpy/memset/memmove as WEAK HIDDEN, poisoning musl's
    # GLOBAL DEFAULT exports via ELF visibility merging. We don't link compiler_rt.
    # Instead, float128_shim.c provides the 128-bit float ops (__addtf3 etc.) with
    # HIDDEN visibility — satisfying internal PLT references without polluting .dynsym.

    # Compile the float128 shim: provides __addtf3 etc. with HIDDEN visibility
    # so they satisfy internal PLT references without appearing in .dynsym.
    # Only needed on aarch64 (where long double = __float128 = 128-bit quad);
    # on x86_64, long double is 80-bit and __subtf3 etc. are not needed by musl.
    var float_shim_obj = ''
    if (ARCH === 'aarch64') {
        "$zig_bin" cc -c -fPIC -fvisibility=hidden \
            -target aarch64-linux-musl \
            -o /tmp/float128_shim.o ../float128_shim.c
        setvar float_shim_obj = '/tmp/float128_shim.o'
    }

    var tab         = u'\u{09}'
    var ldflags_lld = '--sort-section=alignment --sort-common --hash-style=both --export-dynamic'
    var recipe      = "${tab}${zig_bin} ld.lld --shared ${ldflags_lld} --entry _dlstart -o \$@ \$(LOBJS) \$(LDSO_OBJS) ${float_shim_obj}"
    sed -i "s:${tab}.*-nostdlib -shared.*:${recipe}:" ../Makefile

    # Verify the patch landed — fail loudly rather than silently use zig cc.
    grep -q 'zig ld.lld' ../Makefile || { echo 'ERROR: Makefile patch did not apply' >&2; exit 1; }

    make
    make DESTDIR=$dest install

    # ldd symlink.
    var ldso = ''
    case (ARCH) {
        aarch64 { setvar ldso = 'ld-musl-aarch64.so.1' }
        x86_64  { setvar ldso = 'ld-musl-x86_64.so.1' }
    }
    if (ldso !== '') {
        # musl installs ld-musl-*.so.1 as a hard link to libc.so.
        # Replace with a symlink so the relationship survives packaging/tar.
        ln -sf libc.so "${dest}/usr/lib/${ldso}"
    }
    mkdir -p "${dest}/usr/bin"
    ln -sf "/usr/lib/${ldso}" "${dest}/usr/bin/ldd"
}
