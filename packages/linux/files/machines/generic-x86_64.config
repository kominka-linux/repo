# Generic x86_64 — broad driver coverage for unknown hardware.
# Safe fallback when no machine-specific profile is available.
# Errs on the side of inclusion; use a specific profile for a leaner kernel.

# ACPI
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_VIDEO=y
CONFIG_X86_PM_TIMER=y

# CPU frequency
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_INTEL_IDLE=y

# Suspend / resume
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_HOTPLUG_CPU=y

# 802.11 kernel stack (required by all WiFi drivers)
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_FW_LOADER=y

# WiFi: Intel (most common in laptops/NUCs)
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y

# WiFi: Qualcomm / Atheros
CONFIG_ATH_COMMON=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y

# WiFi: Realtek (cheap USB adapters, some laptops)
CONFIG_RTL8XXXU=y
CONFIG_R8188EU=y

# Ethernet: Intel (desktops, NUCs, servers)
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IXGBE=y

# Ethernet: Realtek (common on consumer boards)
CONFIG_R8169=y

# I2C bus (touchpads, sensors)
CONFIG_I2C=y
CONFIG_I2C_I801=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y

# Common touchpad/input
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_CYPRESS=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_ELANTECH=y

# Graphics: Intel (most laptops/NUCs/older desktops)
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_AGP=y
CONFIG_AGP_INTEL=y

# Audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y

# SD card
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_REALTEK_PCI=y
