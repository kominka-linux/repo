# Dell XPS 13 9343 (2015, Broadwell i5/i7-5xxx)
# WiFi:     Intel Wireless 7265 (iwlwifi, MVM firmware)
# Storage:  M.2 SATA via AHCI (covered by base config)
# Display:  Intel HD Graphics 5500 (i915)
# Touchpad: Cypress I2C via Intel LPSS I2C
# USB:      xHCI (covered by base config)

# ACPI — essential for any laptop
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_VIDEO=y
CONFIG_X86_PM_TIMER=y

# CPU frequency scaling
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_IDLE=y

# Suspend / resume
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_HOTPLUG_CPU=y

# WiFi: Intel 7265 (MVM firmware, not DVM)
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_FW_LOADER=y

# Intel HD 5500 graphics
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_AGP=y
CONFIG_AGP_INTEL=y

# I2C bus + Intel LPSS (Low Power Subsystem provides I2C for touchpad)
CONFIG_I2C=y
CONFIG_I2C_I801=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y

# Cypress I2C touchpad
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_HID_CYPRESS=y

# Intel HDA audio (Realtek ALC3263 codec)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y

# Realtek SD card reader
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_REALTEK_PCI=y
