#!/usr/local/bin/ysh

var name    = 'linux'
var ver     = '6.19.12'
var rel     = '2'
var deps    = []
var mkdeps  = ['make', 'bison', 'perl']

var sources = [
    'https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-VERSION.tar.xz',
    'files/kernel.config',
    'files/kernel-x86_64.config',
]
var checksums = [
    'ce5c4f1205f9729286b569b037649591555f31ca1e03cc504bd3b70b8e58a8d5',
    '0125c9ae402accd9fa5c2d05aec3ede0d919d10c0aba513292ab6ae813967da1',
    '04e885aaa2deff3bdeaf72f1ff18aec5daece7ec74a7cfee0a957c3dcb92fc2d',
]

proc build(dest) {
    # uname -m returns aarch64/x86_64; kernel ARCH uses arm64/x86_64.
    var MACH = $(uname -m)
    var ARCH = MACH
    if (MACH === 'aarch64') { setvar ARCH = 'arm64' }

    # Merge tinyconfig with our arch-specific fragment.
    make ARCH=$ARCH tinyconfig

    case (MACH) {
        x86_64  { scripts/kconfig/merge_config.sh -m .config kernel-x86_64.config }
        *       { scripts/kconfig/merge_config.sh -m .config kernel.config }
    }

    make ARCH=$ARCH olddefconfig

    var _nproc = $(nproc 2>/dev/null || echo 4)

    # Build the kernel image.
    case (MACH) {
        x86_64 {
            make -j$_nproc ARCH=$ARCH bzImage
            mkdir -p "${dest}/usr/share/kominka"
            cp arch/x86/boot/bzImage "${dest}/usr/share/kominka/Image"
        }
        * {
            make -j$_nproc ARCH=$ARCH Image
            mkdir -p "${dest}/usr/share/kominka"
            cp arch/arm64/boot/Image "${dest}/usr/share/kominka/Image"
        }
    }

    # Install kernel headers.
    make ARCH=$ARCH headers

    find usr/include -name '*.h' -type f | while read -r file {
        mkdir -p "${dest}/${file%/*}"
        cp -f $file "${dest}/${file}"
    }

    # Save the final .config for reference.
    mkdir -p "${dest}/usr/share/kominka"
    cp .config "${dest}/usr/share/kominka/kernel.config"
}
