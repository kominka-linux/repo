#!/usr/local/bin/ysh

var name    = 'linux'
var ver     = '6.19.12'
var rel     = '5'
var deps    = []
var mkdeps  = ['make', 'bison', 'perl']

var sources = [
    'https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-VERSION.tar.xz',
    'files/kernel.config',
    'files/kernel-x86_64.config',
    'files/machines/dell-xps13-9343.config',
    'files/machines/generic-x86_64.config',
    'files/machines/index',
]
var checksums = [
    'ce5c4f1205f9729286b569b037649591555f31ca1e03cc504bd3b70b8e58a8d5',
    '0125c9ae402accd9fa5c2d05aec3ede0d919d10c0aba513292ab6ae813967da1',
    '04e885aaa2deff3bdeaf72f1ff18aec5daece7ec74a7cfee0a957c3dcb92fc2d',
    '4869eea9729d3dab78b67d28fe8027afaf5aaf9197914044bc80f38f2c458591',
    '6eb882bfc1db00ff75e11f17da73aae496146a04a6e0e2d00dcaabbbf5c55c5a',
    '841aaa44cd8f08daf2f51132f167a55ceb49866c21f2c4e25e88d085f2622bf5',
]

proc build(dest) {
    # uname -m returns aarch64/x86_64; kernel ARCH uses arm64/x86_64.
    var MACH = $(uname -m)
    var ARCH = MACH
    if (MACH === 'aarch64') { setvar ARCH = 'arm64' }

    # Use zig cc/ld.lld directly, not our /usr/bin/cc wrapper.
    # The wrapper adds -target ARCH-linux-musl which conflicts with the kernel's
    # own -march/ABI flags and breaks the arm64 vdso build (BTI/PAC sections).
    # zig cc without -target auto-detects from the running host.
    var ZIG    = $(command -v zig)
    var CC     = "$ZIG cc"
    var LD     = "$ZIG ld.lld"
    # zig objcopy doesn't implement -S (strip-all) used by the arm64 vdso strip
    # step. Use Alpine's binutils objcopy saved during bootstrap image build.
    var OBJCOPY = '/usr/local/bin/gnu-objcopy'
    if ! test -f $OBJCOPY { setvar OBJCOPY = $(command -v objcopy) }

    # Merge tinyconfig with our arch-specific fragment.
    make ARCH=$ARCH CC=$CC LD=$LD OBJCOPY=$OBJCOPY tinyconfig

    case (MACH) {
        x86_64  { scripts/kconfig/merge_config.sh -m .config kernel-x86_64.config }
        *       { scripts/kconfig/merge_config.sh -m .config kernel.config }
    }

    make ARCH=$ARCH CC=$CC LD=$LD OBJCOPY=$OBJCOPY olddefconfig

    var _nproc = $(nproc 2>/dev/null || echo 4)

    # Build the kernel image.
    case (MACH) {
        x86_64 {
            make -j$_nproc ARCH=$ARCH CC=$CC LD=$LD OBJCOPY=$OBJCOPY bzImage
            mkdir -p "${dest}/usr/share/kominka"
            cp arch/x86/boot/bzImage "${dest}/usr/share/kominka/Image"
        }
        * {
            make -j$_nproc ARCH=$ARCH CC=$CC LD=$LD OBJCOPY=$OBJCOPY Image
            mkdir -p "${dest}/usr/share/kominka"
            cp arch/arm64/boot/Image "${dest}/usr/share/kominka/Image"
        }
    }

    # Install kernel headers.
    make ARCH=$ARCH CC=$CC LD=$LD OBJCOPY=$OBJCOPY headers

    find usr/include -name '*.h' -type f | while read -r file {
        mkdir -p "${dest}/${file%/*}"
        cp -f $file "${dest}/${file}"
    }

    # Save the final .config for reference.
    mkdir -p "${dest}/usr/share/kominka"
    cp .config "${dest}/usr/share/kominka/kernel.config"

    # Install machine profiles so the installer can build machine-specific kernels.
    mkdir -p "${dest}/usr/share/kominka/machines"
    cp -f dell-xps13-9343.config  "${dest}/usr/share/kominka/machines/"
    cp -f generic-x86_64.config   "${dest}/usr/share/kominka/machines/"
    cp -f index                    "${dest}/usr/share/kominka/machines/"
}
