#!/usr/local/bin/ysh

var name    = 'linux'
var ver     = '6.19.12'
var rel     = '10'
var deps    = []
var mkdeps  = ['make', 'bison', 'flex', 'm4', 'binutils']

var sources = [
    'https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-VERSION.tar.xz',
    'files/kernel.config',
    'files/kernel-x86_64.config',
    'files/machines/dell-xps13-9343.config',
    'files/machines/generic-x86_64.config',
    'files/machines/index',
]
var checksums = [
    'ce5c4f1205f9729286b569b037649591555f31ca1e03cc504bd3b70b8e58a8d5',
    '0125c9ae402accd9fa5c2d05aec3ede0d919d10c0aba513292ab6ae813967da1',
    '04e885aaa2deff3bdeaf72f1ff18aec5daece7ec74a7cfee0a957c3dcb92fc2d',
    '4869eea9729d3dab78b67d28fe8027afaf5aaf9197914044bc80f38f2c458591',
    '6eb882bfc1db00ff75e11f17da73aae496146a04a6e0e2d00dcaabbbf5c55c5a',
    '841aaa44cd8f08daf2f51132f167a55ceb49866c21f2c4e25e88d085f2622bf5',
]

proc build(dest) {
    # uname -m returns aarch64/x86_64; kernel ARCH uses arm64/x86_64.
    var MACH = $(seed uname -m)
    var ARCH = MACH
    if (MACH === 'aarch64') { setvar ARCH = 'arm64' }

    # zig objcopy doesn't implement -S (strip-all) used by the arm64 vdso strip
    # step. Use Alpine's binutils objcopy saved in Dockerfile.bootstrap.
    var OBJCOPY = '/usr/local/bin/gnu-objcopy'
    if ! builtin test -f $OBJCOPY { setvar OBJCOPY = $(builtin command -v objcopy) }

    # x86 realmode trampoline (arch/x86/realmode/rm/) uses a linker script
    # that lld can't handle (pa_* physical-address symbols). GNU ld required.
    # arm64 works fine with lld; no LD override needed there.
    var ld_args = []
    if (MACH === 'x86_64') {
        var gnu_ld = '/usr/local/bin/gnu-ld'
        if builtin test -f $gnu_ld { setvar ld_args = ["LD=$gnu_ld"] }
    }

    var host_args = ['HOSTCC=cc']

    # -fintegrated-as: prevents Makefile.clang from adding --target=... and
    # -Werror=unused-command-line-argument to KBUILD_CPPFLAGS, which break
    # non-clang host tool compilation.
    var clang_flags = ['CLANG_FLAGS=-fintegrated-as']

    # arch/arm64/tools scripts use gawk extensions; seed awk can't handle them.
    # Override with no-ops since we supply pre-generated headers in sources[].
    var gen_overrides = ['cmd_gen_cpucaps=:', 'cmd_gen_sysreg=:']

    # zig cc -S + -MMD produces no output (zig bug). Strip -Wp% dep flags and
    # emit a minimal dep file manually so assembly compilation succeeds.
    var cc_s_c_override = [
        "cmd_cc_s_c=\$(CC) \$(filter-out -Wp%,\$(c_flags)) -fno-integrated-as -Wa,-gdwarf-2 -S -o \$@ \$< && echo \"\$@:\" > \$(depfile)"
    ]

    # Merge tinyconfig with our arch-specific fragment.
    make ARCH=$ARCH @host_args @clang_flags tinyconfig

    case (MACH) {
        x86_64  { scripts/kconfig/merge_config.sh -m .config kernel-x86_64.config }
        *       { scripts/kconfig/merge_config.sh -m .config kernel.config }
    }

    make ARCH=$ARCH OBJCOPY=$OBJCOPY @ld_args @host_args @clang_flags olddefconfig

    var _nproc = $(seed nproc 2>/dev/null || builtin echo 4)

    # Build the kernel image.
    case (MACH) {
        x86_64 {
            make -j$_nproc ARCH=$ARCH OBJCOPY=$OBJCOPY @ld_args @host_args @clang_flags @gen_overrides @cc_s_c_override bzImage
            seed mkdir -p "${dest}/usr/share/kominka"
            seed cp arch/x86/boot/bzImage "${dest}/usr/share/kominka/Image"
        }
        * {
            make -j$_nproc ARCH=$ARCH OBJCOPY=$OBJCOPY @host_args @clang_flags @gen_overrides @cc_s_c_override Image
            seed mkdir -p "${dest}/usr/share/kominka"
            seed cp arch/arm64/boot/Image "${dest}/usr/share/kominka/Image"
        }
    }

    # Install kernel headers.
    make ARCH=$ARCH OBJCOPY=$OBJCOPY @ld_args @host_args @clang_flags headers

    seed find usr/include -name '*.h' -type f | while builtin read -r file {
        seed mkdir -p "${dest}/${file%/*}"
        seed cp -f $file "${dest}/${file}"
    }

    # Save the final .config for reference.
    seed mkdir -p "${dest}/usr/share/kominka"
    seed cp .config "${dest}/usr/share/kominka/kernel.config"

    # Install machine profiles so the installer can build machine-specific kernels.
    seed mkdir -p "${dest}/usr/share/kominka/machines"
    seed cp -f dell-xps13-9343.config  "${dest}/usr/share/kominka/machines/"
    seed cp -f generic-x86_64.config   "${dest}/usr/share/kominka/machines/"
    seed cp -f index                    "${dest}/usr/share/kominka/machines/"
}
