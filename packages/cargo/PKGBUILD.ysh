#!/usr/local/bin/ysh

var name    = 'cargo'
var ver     = '1.94.1'
var rel     = '3'
var deps    = ['musl']
var mkdeps  = []

# musl-linked toolchain — no glibc, no libgcc_s needed.
var sources = [
    'https://static.rust-lang.org/dist/rust-VERSION-ARCH-unknown-linux-musl.tar.gz',
]
var checksums_aarch64 = [
    'caa1d50676518532cc9b4c4c491f219edbdcb9ebf9e6624432b5b43b87d8cc0a',
]
var checksums_x86_64  = [
    '5568d1b7992dcb0cabc9936476a0569ff314a3f1322886b4f414eb2d07b0ffd6',
]

proc build(dest) {
    # cargo — precompiled Rust toolchain (rustc, cargo, std) from rust-lang.org.

    # Binaries
    mkdir -p "${dest}/usr/bin"
    cp rustc/bin/rustc "${dest}/usr/bin/"
    cp rustc/bin/rustdoc "${dest}/usr/bin/"
    cp cargo/bin/cargo "${dest}/usr/bin/"

    # Libraries (rustc libs + std)
    mkdir -p "${dest}/usr/lib"
    cp -a rustc/lib/* "${dest}/usr/lib/"
    for d in @[glob("rust-std-*/lib/*")] {
        cp -a $d "${dest}/usr/lib/" 2>/dev/null || true
    }
}
